// model names get retired every so often. If scans start failing with a 404 about the model,
// check which ones your key can use: https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
var GEMINI_MODEL = 'gemini-3.1-flash-lite';
var GEMINI_API_URL = 'https://generativelanguage.googleapis.com/v1beta/models/' + GEMINI_MODEL + ':generateContent';

function onOpen() {

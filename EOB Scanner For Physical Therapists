/**
 * Splits a "data:<mime>;base64,<data>" URL into its MIME type and raw
 * base64 payload, defaulting to image/png when base64Data has no such
 * prefix (a bare base64 string). Any MIME type is accepted here — the
 * sidebar's file input takes both images and PDFs, and Gemini's
 * generateContent endpoint accepts a PDF the same way as an image, via
 * inline_data with mime_type "application/pdf".
 */
function parseDataUrl_(base64Data) {
  var mimeMatch = base64Data.match(/^data:([a-zA-Z0-9.+-]+\/[a-zA-Z0-9.+-]+);base64,/);
  return {
    mimeType: mimeMatch ? mimeMatch[1] : 'image/png',
    data: base64Data.replace(/^data:[a-zA-Z0-9.+-]+\/[a-zA-Z0-9.+-]+;base64,/, '')
  };
}

/**
 * Sends a screenshot or PDF to Gemini and returns extracted authorization
 * fields as JSON. base64Data may be a raw base64 string or a full
 * "data:<mime>;base64,...." URL — the data: prefix is stripped here before
 * the file is sent to the Gemini API.
 *
 * @param {string} base64Data Image or PDF data captured from the file input.
 * @return {{success: boolean, data?: Object, error?: string}}
 */
function processImage(base64Data) {
  try {
    if (!base64Data) {
      throw new Error('No image data was received.');
    }

    var apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
    if (!apiKey) {
      throw new Error('Gemini API key is not configured. In the Apps Script editor, open Project Settings > Script Properties and add a GEMINI_API_KEY property.');
    }

    var parsedFile = parseDataUrl_(base64Data);
    var mimeType = parsedFile.mimeType;
    var cleanBase64 = parsedFile.data;

    var prompt = 'Analyze this insurance authorization document (a screenshot or a PDF). Extract the Patient Name, Member ID, Auth Number, Approved Visits, Start Date, and End Date. Return ONLY a valid, raw JSON object with these keys (no markdown formatting, no backticks).';

    var payload = {
      contents: [
        {
          parts: [
            { text: prompt },
            {
              inline_data: {
                mime_type: mimeType,
                data: cleanBase64
              }
            }
          ]
        }
      ],
      generationConfig: {
        temperature: 0.1
      }
    };

    var options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };

    var response = UrlFetchApp.fetch(GEMINI_API_URL + '?key=' + apiKey, options);
    var responseCode = response.getResponseCode();
    var responseBody = response.getContentText();

    if (responseCode !== 200) {
      var apiErrorMessage = responseBody;
      try {
        var errorJson = JSON.parse(responseBody);
        if (errorJson.error && errorJson.error.message) {
          apiErrorMessage = errorJson.error.message;
        }
      } catch (parseErrorIgnored) {
        // Error body wasn't JSON — fall back to the raw response text.
      }
      throw new Error('Gemini API error (' + responseCode + '): ' + apiErrorMessage);
    }

    var responseData = JSON.parse(responseBody);
    var candidate = responseData.candidates && responseData.candidates[0];
    var textPart = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0];

    if (!textPart || !textPart.text) {
      throw new Error('Gemini did not return any readable text. The image may be unclear, unreadable, or blocked by safety filters.');
    }

    var cleanedText = textPart.text.replace(/```json/gi, '').replace(/```/g, '').trim();

    var parsed;
    try {
      parsed = JSON.parse(cleanedText);
    } catch (jsonErrorIgnored) {
      throw new Error('Gemini response was not valid JSON: ' + cleanedText);
    }

    return { success: true, data: normalizeExtractedData_(parsed) };

  } catch (error) {
    return { success: false, error: error.message };
  }
}

/**
 * Maps Gemini's returned object onto a fixed set of camelCase keys
 * regardless of the exact casing/spacing/underscoring it used, since
 * LLM JSON output does not reliably repeat key formatting verbatim.
 */
function normalizeExtractedData_(rawData) {
  var normalizedMap = {};
  Object.keys(rawData || {}).forEach(function (key) {
    normalizedMap[normalizeKey_(key)] = rawData[key];
  });

  function pick() {
    for (var i = 0; i < arguments.length; i++) {
      var value = normalizedMap[normalizeKey_(arguments[i])];
      if (value !== undefined && value !== null && value !== '') {
        return value;
      }
    }
    return '';
  }

  return {
    patientName: pick('Patient Name', 'PatientName', 'patient_name', 'name'),
    memberId: pick('Member ID', 'MemberID', 'member_id', 'memberId'),
    authNumber: pick('Auth Number', 'Authorization Number', 'AuthNumber', 'auth_number'),
    approvedVisits: pick('Approved Visits', 'ApprovedVisits', 'approved_visits', 'visits'),
    startDate: pick('Start Date', 'StartDate', 'start_date', 'Effective Date'),
    endDate: pick('End Date', 'EndDate', 'end_date', 'Expiration Date')
  };
}

function normalizeKey_(key) {
  return String(key).toLowerCase().replace(/[^a-z0-9]/g, '');
}

/**
 * Appends the reviewed form data to the next available row in the active
 * sheet, writing a bold header row first if the sheet is currently empty.
 *
 * @param {{patientName:string, memberId:string, authNumber:string,
 *          approvedVisits:(string|number), startDate:string, endDate:string}} patientData
 * @return {{success: boolean, error?: string}}
 */
function appendData(patientData) {
  try {
    if (!patientData || !String(patientData.patientName || '').trim()) {
      throw new Error('Patient Name is required before saving.');
    }

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var headers = ['Patient Name', 'Member ID', 'Auth Number', 'Approved Visits', 'Start Date', 'End Date'];

    if (sheet.getLastRow() === 0) {
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    }

    sheet.appendRow([
      patientData.patientName || '',
      patientData.memberId || '',
      patientData.authNumber || '',
      patientData.approvedVisits || '',
      patientData.startDate || '',
      patientData.endDate || ''
    ]);

    return { success: true };

  } catch (error) {
    return { success: false, error: error.message };
  }
}

/* ---------------------------------------------------------------------
 * Flush Attendance Auto-Biller — EOB / remittance advice scanning and
 * batch reconciliation against the active sheet.
 * ------------------------------------------------------------------- */

/**
 * Sends a request to Gemini. While Gemini answers that it is busy or briefly
 * unavailable (GEMINI_RETRY_CODES), waits and sends the same request again,
 * once for each entry in GEMINI_RETRY_WAIT_SECONDS. Returns the last
 * response, so a reply that is still busy after the last try is reported
 * the same way as before.
 *
 * @param {string} url Gemini endpoint, including the API key.
 * @param {Object} options UrlFetchApp options; muteHttpExceptions must be true.
 * @return {HTTPResponse} The last response from Gemini.
 */
function fetchGeminiWithRetry_(url, options) {
  var response = UrlFetchApp.fetch(url, options);
  for (var retry = 0; retry < GEMINI_RETRY_WAIT_SECONDS.length; retry++) {
    var responseCode = response.getResponseCode();
    if (GEMINI_RETRY_CODES.indexOf(responseCode) === -1) {
      break;
    }
    console.log('Gemini is busy (' + responseCode + '); try ' + (retry + 2) + ' of ' +
      (GEMINI_RETRY_WAIT_SECONDS.length + 1) + ' in ' + GEMINI_RETRY_WAIT_SECONDS[retry] + ' s.');
    Utilities.sleep(GEMINI_RETRY_WAIT_SECONDS[retry] * 1000);
    response = UrlFetchApp.fetch(url, options);
  }
  return response;
}

/**
 * Sends a screenshot or PDF of an EOB / remittance advice to Gemini and
 * returns the extracted payment line items as an array. base64Data may be a
 * raw base64 string or a full "data:<mime>;base64,...." URL — the data:
 * prefix is stripped here before the file is sent to the Gemini API. A PDF
 * may have several pages; Gemini is asked to pull claims from all of them.
 * It also reads a screenshot of an Inovalon Claim Management Pro claims
 * list. That list has no check number or payment date (and its Import Date
 * is not the payment date), so those come back blank and get filled in from
 * the sidebar instead. If Gemini is busy, the request is sent again a few
 * times before the scan fails (see fetchGeminiWithRetry_).
 *
 * @param {string} base64Data Image or PDF data captured from the file input.
 * @return {{success: boolean, data?: Object[], error?: string}}
 */
function processEOBImage(base64Data) {
  try {
    if (!base64Data) {
      throw new Error('No image data was received.');
    }

    var apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
    if (!apiKey) {
      throw new Error('Gemini API key is not configured. In the Apps Script editor, open Project Settings > Script Properties and add a GEMINI_API_KEY property.');
    }

    var parsedFile = parseDataUrl_(base64Data);
    var mimeType = parsedFile.mimeType;
    var cleanBase64 = parsedFile.data;

    var prompt = 'This is an insurance EOB / remittance advice, provided as either a single image or a PDF that ' +
      'may span multiple pages — if there is more than one page, extract claims from every page. The ' +
      'payer/insurance company name is shown once near the top (e.g. a company name and address block). It lists ' +
      'one or more patient claims. Each claim starts with a line like "NAME: <Last, First>" and may show ' +
      'HIC/ACNT/ICN numbers, then one or more procedure-code line items (each with its own SERV DATE, an ' +
      'adjustment/reason code such as CO-197, CO-45, or CO-209, and a PROV PD amount), followed by a row labeled ' +
      '"CLAIM TOTALS" that sums those procedure lines, and then usually a separate "Adj to Totals" line below that ' +
      'with its own PREV PD / INTEREST / NET figures — CLAIM TOTALS and NET are two different numbers and must not ' +
      'be confused for each other. A single Date and Check/EFT number are also shown once near the top of each ' +
      'page. The payer name, Date, and Check/EFT number apply to every claim on the same page as them.\n\n' +
      'The image may instead be a claims list from Inovalon Claim Management Pro: a table with one row per claim ' +
      'and column headers such as Import Date, Patient Ctl No, Patient Name, Claim Charge, Claim Payment, Statement ' +
      'Start, Statement End and Payer Name. For that kind of table, return one object per table row and fill the ' +
      'keys below this way instead: patientName from the Patient Name column; serviceDate from the Statement Start ' +
      'column; insurance from that row\'s Payer Name column; amountPaid from the Claim Payment column (never Claim ' +
      'Charge); reasonCode only if the row shows an adjustment/reason code, otherwise an empty string; and paidDate ' +
      'and checkNo only if the table shows a payment/check date or a check/EFT number for that row, otherwise empty ' +
      'strings. The Import Date is when the remittance was loaded into Inovalon, not when the claim was paid, so ' +
      'never use it for paidDate or for anything else.\n\n' +
      'Return ONLY a raw JSON array of objects (no markdown formatting, no backticks, no surrounding text), with ' +
      'ONE object per claim — that is, per patient per service date. If the same patient name appears in two ' +
      'separate claim blocks with different service dates, treat them as two separate objects; if one claim has ' +
      'several procedure-code lines, combine them into a single object. Each object must have these keys, and ' +
      'every value must be a JSON string even if it looks like a number (e.g. "checkNo": "157186", not 157186):\n' +
      '- patientName: the NAME field, formatted exactly as printed (typically "Last, First Middle")\n' +
      '- serviceDate: the SERV DATE for this claim\n' +
      '- insurance: the payer/insurance company name shown near the top of that page\n' +
      '- paidDate: the Date shown once near the top of that page\n' +
      '- checkNo: the Check/EFT number shown once near the top of that page, digits only, with no letter prefix ' +
      '(e.g. "157186", not "C-157186")\n' +
      '- reasonCode: every distinct adjustment/reason code that appears anywhere in this claim\'s procedure lines, ' +
      'joined with ", " (empty string if none appear)\n' +
      '- amountPaid: the paid-amount figure on this claim\'s CLAIM TOTALS row specifically — the sum of the PROV ' +
      'PD column across its procedure lines. Do NOT use the NET figure from the separate "Adj to Totals" line, ' +
      'even when one is shown and even if the two numbers happen to look close. If there is no CLAIM TOTALS row at ' +
      'all, sum the PROV PD amounts across that claim\'s procedure lines yourself instead\n\n' +
      'Use an empty string for any value that is not present.';

    var payload = {
      contents: [
        {
          parts: [
            { text: prompt },
            {
              inline_data: {
                mime_type: mimeType,
                data: cleanBase64
              }
            }
          ]
        }
      ],
      generationConfig: {
        temperature: 0.1
      }
    };

    var options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };

    var response = fetchGeminiWithRetry_(GEMINI_API_URL + '?key=' + apiKey, options);
    var responseCode = response.getResponseCode();
    var responseBody = response.getContentText();

    if (responseCode !== 200) {
      var apiErrorMessage = responseBody;
      try {
        var errorJson = JSON.parse(responseBody);
        if (errorJson.error && errorJson.error.message) {
          apiErrorMessage = errorJson.error.message;
        }
      } catch (parseErrorIgnored) {
        // Error body wasn't JSON — fall back to the raw response text.
      }
      throw new Error('Gemini API error (' + responseCode + '): ' + apiErrorMessage);
    }

    var responseData = JSON.parse(responseBody);
    var candidate = responseData.candidates && responseData.candidates[0];
    var textPart = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0];

    if (!textPart || !textPart.text) {
      throw new Error('Gemini did not return any readable text. The image may be unclear, unreadable, or blocked by safety filters.');
    }

    var cleanedText = textPart.text.replace(/```json/gi, '').replace(/```/g, '').trim();

    var parsed;
    try {
      parsed = JSON.parse(cleanedText);
    } catch (jsonErrorIgnored) {
      throw new Error('Gemini response was not valid JSON: ' + cleanedText);
    }

    if (!Array.isArray(parsed)) {
      parsed = [parsed];
    }

    var payments = parsed.map(normalizeEOBRow_);
    logUsage_('EOB scanner', 'Scan EOB', true, payments.length + ' payment line' + (payments.length === 1 ? '' : 's'));
    return { success: true, data: payments };

  } catch (error) {
    logUsage_('EOB scanner', 'Scan EOB', false, error.message);
    return { success: false, error: error.message };
  }
}

/**
 * Maps a single Gemini-returned payment line onto a fixed set of camelCase
 * keys regardless of the exact casing/spacing/underscoring it used, since
 * LLM JSON output does not reliably repeat key formatting verbatim.
 */
function normalizeEOBRow_(rawRow) {
  var normalizedMap = {};
  Object.keys(rawRow || {}).forEach(function (key) {
    normalizedMap[normalizeKey_(key)] = rawRow[key];
  });

  function pick() {
    for (var i = 0; i < arguments.length; i++) {
      var value = normalizedMap[normalizeKey_(arguments[i])];
      if (value !== undefined && value !== null && value !== '') {
        return value;
      }
    }
    return '';
  }

  return {
    patientName: pick('Patient Name', 'PatientName', 'patient_name', 'name'),
    serviceDate: pick('Service Date', 'ServiceDate', 'service_date', 'Date of Service', 'DOS', 'Statement Start'),
    insurance: pick('Insurance', 'Insurance Company', 'Payer', 'insurance_company', 'Payer Name'),
    paidDate: pick('Paid Date', 'PaidDate', 'paid_date', 'Date/Check EFT Date', 'Check EFT Date', 'Check Date'),
    checkNo: String(pick('Check No.', 'Check No', 'CheckNo', 'check_no', 'Check/EFT Number', 'Check EFT Number') || '').trim(),
    reasonCode: pick('Reason Code', 'ReasonCode', 'reason_code', 'Reason'),
    amountPaid: pick('Amount Paid', 'AmountPaid', 'amount_paid', 'PROV PD', 'Amount', 'Claim Payment')
  };
}

/**
 * Batch-reconciles extracted EOB payment lines into the tab picked in the sidebar. Not
 * specific to any one office's tab: every column this needs (Patient
 * Name, Paid Date, Reason, Check No., Amount, Insurance) is located by
 * header text rather than a fixed position, so any sheet reusing the same
 * headings works the same way regardless of which columns they land in —
 * only the Patient Name column falls back to column A when nothing labels
 * it, matching every version of this particular ledger seen so far. That
 * column holds either a date-heading row ("March 16,2026(MON.)" or
 * "08/21/26(FRI.)", as text or an actual Date cell) marking a visit date,
 * or a patient name below that heading (often prefixed with a list number,
 * e.g. "21. ZHU, XINGJIA"), until a blank row ends the group. A row is
 * created the day the patient is seen (Name + Insurance only) and its Paid
 * Date/Reason/Check No./Amount are filled in later, on that same row, once
 * the EOB arrives — so reconciling means finding that row, not adding a
 * new one.
 *
 * For each extracted payment: find the heading whose date matches the
 * payment's Service Date, then within that group find a row for the same
 * patient that's still unreconciled (Paid Date/Check No./Amount all blank)
 * and fill it in. This never adds a row to the sheet under any
 * circumstance — every row it can ever touch already exists, created ahead
 * of time by whoever logs the visit. If every matching row is already
 * reconciled, nothing is written: an exact repeat (same patient/paid
 * date/check no./amount) is counted as a duplicate — expected when the
 * same EOB gets scanned twice — and anything else that already has
 * different data recorded is reported as a conflict for manual review
 * instead of being guessed at. A payment with no matching row at all
 * (wrong/missing service date, or the visit was never logged) is reported
 * as unresolved, also without writing anywhere.
 *
 * The payments go to the tab picked in the sidebar's "Post to tab" dropdown
 * (sheetName). Without a sheetName it falls back to whichever tab is open,
 * which is how it worked before the sidebar had the dropdown.
 *
 * @param {Object[]} paymentDataArray Rows shaped like normalizeEOBRow_'s output.
 * @param {string=} sheetName Name of the attendance tab to post to.
 * @return {{success: boolean, sheetName?: string, updatedCount?: number,
 *           duplicateCount?: number, conflictCount?: number, conflicts?: string[],
 *           unresolvedCount?: number, unresolved?: string[], error?: string}}
 */
function reconcilePayments(paymentDataArray, sheetName) {
  try {
    if (!paymentDataArray || !paymentDataArray.length) {
      throw new Error('No payment records to reconcile.');
    }

    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = sheetName ? spreadsheet.getSheetByName(sheetName) : spreadsheet.getActiveSheet();
    if (!sheet) {
      throw new Error('There is no tab named "' + sheetName + '" anymore. It may have been renamed or deleted; click ↻ next to the tab list to reload it.');
    }

    var ledger = findLedgerColumns_(sheet);
    if (!ledger) {
      throw new Error('The "' + sheet.getName() + '" tab does not look like an attendance tab: could not find Paid Date / Reason / Check No. / Amount headers in its first ' + LEDGER_HEADER_ROWS + ' rows.');
    }

    var nameCol = ledger.nameCol;
    var paidDateCol = ledger.paidDateCol;
    var reasonCol = ledger.reasonCol;
    var checkNoCol = ledger.checkNoCol;
    var amountCol = ledger.amountCol;
    var insuranceCol = ledger.insuranceCol;
    var lastCol = ledger.lastCol;
    var lastRow = ledger.lastRow;
    var dataStartRow = ledger.dataStartRow;
    var grid = lastRow >= dataStartRow
      ? sheet.getRange(dataStartRow, 1, lastRow - dataStartRow + 1, lastCol).getValues()
      : [];

    // Walk the sheet top to bottom, grouping patient rows under whichever
    // date heading they fall below (a blank row or the next heading ends
    // the group).
    var groups = [];
    var currentGroup = null;

    for (var r = 0; r < grid.length; r++) {
      var rowValues = grid[r];
      var sheetRow = dataStartRow + r;
      var headingDate = parseHeadingDate_(rowValues[nameCol - 1]);

      if (headingDate) {
        currentGroup = { headingDate: headingDate, lastRow: sheetRow, rows: [] };
        groups.push(currentGroup);
        continue;
      }

      var nameCellText = String(rowValues[nameCol - 1] || '').trim();
      if (!nameCellText || /^closed$/i.test(nameCellText)) {
        continue;
      }

      if (currentGroup) {
        currentGroup.rows.push({
          sheetRow: sheetRow,
          patientName: nameCellText,
          insurance: insuranceCol ? rowValues[insuranceCol - 1] : '',
          paidDate: rowValues[paidDateCol - 1],
          checkNo: rowValues[checkNoCol - 1],
          amount: rowValues[amountCol - 1]
        });
        currentGroup.lastRow = sheetRow;
      }
    }

    var groupsByDate = {};
    groups.forEach(function (group) {
      (groupsByDate[group.headingDate] = groupsByDate[group.headingDate] || []).push(group);
    });

    var checkNoPrefix = detectCheckNoPrefix_(groups);

    var updatedCount = 0;
    var duplicateCount = 0;
    var conflicts = [];
    var unresolved = [];

    paymentDataArray.forEach(function (payment) {
      var serviceDateKey = normalizeDateForCompare_(payment.serviceDate);
      var candidateGroups = groupsByDate[serviceDateKey];

      if (!candidateGroups || !candidateGroups.length) {
        unresolved.push((payment.patientName || '(blank name)') + ' — no ' + (payment.serviceDate || '(blank date)') + ' section found');
        return;
      }

      var blankRow = null;
      var isDuplicate = false;
      var hasReconciledMatch = false;

      candidateGroups.forEach(function (group) {
        group.rows.forEach(function (row) {
          if (!namesMatch_(row.patientName, payment.patientName)) {
            return;
          }
          var alreadyReconciled = row.paidDate || row.checkNo || row.amount;
          if (!alreadyReconciled) {
            blankRow = blankRow || row;
            return;
          }
          hasReconciledMatch = true;
          var existingFingerprint = fingerprintPayment_({ patientName: row.patientName, paidDate: row.paidDate, checkNo: row.checkNo, amountPaid: row.amount });
          if (existingFingerprint === fingerprintPayment_(payment)) {
            isDuplicate = true;
          }
        });
      });

      // Only ever write into a row that's genuinely still blank. A match
      // that already has payment data — whether an exact repeat or one
      // that looks like a correction — is reported, never written: this
      // ledger's rows are created ahead of time by whoever logs the visit,
      // so a row that's already filled in is not this function's to change,
      // and nothing new gets added to the sheet either way.
      if (blankRow) {
        sheet.getRange(blankRow.sheetRow, paidDateCol).setValue(payment.paidDate || '');
        sheet.getRange(blankRow.sheetRow, reasonCol).setValue(payment.reasonCode || '');
        sheet.getRange(blankRow.sheetRow, checkNoCol).setValue(formatCheckNo_(payment.checkNo, checkNoPrefix));
        sheet.getRange(blankRow.sheetRow, amountCol).setValue(parseAmount_(payment.amountPaid));
        if (insuranceCol && !blankRow.insurance) {
          sheet.getRange(blankRow.sheetRow, insuranceCol).setValue(payment.insurance || '');
        }
        updatedCount++;
      } else if (isDuplicate) {
        duplicateCount++;
      } else if (hasReconciledMatch) {
        conflicts.push((payment.patientName || '(blank name)') + ' on ' + (payment.serviceDate || '(blank date)') + ' already has different payment data recorded — left unchanged');
      } else {
        unresolved.push((payment.patientName || '(blank name)') + ' — no matching row found under ' + (payment.serviceDate || '(blank date)'));
      }
    });

    logUsage_('EOB scanner', 'Reconcile', true, 'Tab "' + sheet.getName() + '": filled ' + updatedCount +
      ', already there ' + duplicateCount + ', different data ' + conflicts.length + ', no match ' + unresolved.length);

    return {
      success: true,
      sheetName: sheet.getName(),
      updatedCount: updatedCount,
      duplicateCount: duplicateCount,
      conflictCount: conflicts.length,
      conflicts: conflicts,
      unresolvedCount: unresolved.length,
      unresolved: unresolved
    };

  } catch (error) {
    logUsage_('EOB scanner', 'Reconcile', false, error.message);
    return { success: false, error: error.message };
  }
}

/** How many rows from the top of a tab to search for the column headers. */
var LEDGER_HEADER_ROWS = 4;

/**
 * Lists the tabs the Flush Attendance sidebar can post payments to, for its
 * "Post to tab" dropdown: every tab that has the Paid Date / Reason /
 * Check No. / Amount headers, in the same order as the tabs along the bottom
 * of the sheet. `active` is the tab that's open right now, so the dropdown
 * can start on it.
 *
 * @return {{success: boolean, tabs?: {name: string, hidden: boolean}[],
 *           active?: string, error?: string}}
 */
function getLedgerTabs() {
  try {
    var spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    var tabs = [];
    spreadsheet.getSheets().forEach(function (sheet) {
      if (sheet.getType() !== SpreadsheetApp.SheetType.GRID) {
        return; // chart-only tabs have no cells to post to
      }
      if (findLedgerColumns_(sheet)) {
        tabs.push({ name: sheet.getName(), hidden: sheet.isSheetHidden() });
      }
    });
    return { success: true, tabs: tabs, active: spreadsheet.getActiveSheet().getName() };
  } catch (error) {
    return { success: false, error: error.message };
  }
}

/**
 * Finds the columns reconciliation needs on one tab. Every header is located
 * by label text rather than a fixed position, so any sheet that reuses the
 * same headings works the same way regardless of which office it's for or
 * which column they land in — labels have moved between row 1 and row 2
 * across different exports of this same sheet, so a few rows are searched
 * rather than assuming a fixed layout. The one column with no reliable label
 * of its own is the patient-name/date-heading column: if something
 * recognizable ("Patient Name", "Patient", "Name") is found, that column is
 * used; if not — as in this ledger's own sheet, which has never consistently
 * labeled it — column A is assumed, since every version of this sheet seen so
 * far has used it that way regardless of whether it carries a label.
 *
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet
 * @return {?{nameCol: number, paidDateCol: number, reasonCol: number,
 *           checkNoCol: number, amountCol: number, insuranceCol: (number|undefined),
 *           dataStartRow: number, lastRow: number, lastCol: number}}
 *         null when the tab is empty or is missing any of the payment headers.
 */
function findLedgerColumns_(sheet) {
  var lastCol = sheet.getLastColumn();
  var lastRow = sheet.getLastRow();
  if (lastCol < 1 || lastRow < 2) {
    return null;
  }

  var nameCol, paidDateCol, reasonCol, checkNoCol, amountCol, insuranceCol;
  var lastHeaderRow = 1;
  var headerSearchRows = Math.min(LEDGER_HEADER_ROWS, lastRow);
  var headerGrid = sheet.getRange(1, 1, headerSearchRows, lastCol).getValues();

  for (var hr = 0; hr < headerGrid.length; hr++) {
    for (var hc = 0; hc < lastCol; hc++) {
      var key = normalizeKey_(headerGrid[hr][hc]);
      if (!key) {
        continue;
      }
      var found = true;
      if (!nameCol && (key === normalizeKey_('Patient Name') || key === normalizeKey_('Patient') || key === normalizeKey_('Name'))) {
        nameCol = hc + 1;
      } else if (!paidDateCol && key === normalizeKey_('Paid Date')) {
        paidDateCol = hc + 1;
      } else if (!reasonCol && (key === normalizeKey_('Reason') || key === normalizeKey_('Reason Code'))) {
        reasonCol = hc + 1;
      } else if (!checkNoCol && (key === normalizeKey_('Check No.') || key === normalizeKey_('Check No'))) {
        checkNoCol = hc + 1;
      } else if (!amountCol && (key === normalizeKey_('Amount') || key === normalizeKey_('Amount Paid'))) {
        amountCol = hc + 1;
      } else if (!insuranceCol && key === normalizeKey_('Insurance')) {
        insuranceCol = hc + 1;
      } else {
        found = false;
      }
      if (found) {
        lastHeaderRow = Math.max(lastHeaderRow, hr + 1);
      }
    }
  }

  if (!paidDateCol || !reasonCol || !checkNoCol || !amountCol) {
    return null;
  }

  return {
    nameCol: nameCol || 1,
    paidDateCol: paidDateCol,
    reasonCol: reasonCol,
    checkNoCol: checkNoCol,
    amountCol: amountCol,
    insuranceCol: insuranceCol, // undefined when the tab has no Insurance column
    dataStartRow: lastHeaderRow + 1,
    lastRow: lastRow,
    lastCol: lastCol
  };
}

/**
 * Detects whether a column-A cell is a date-heading row rather than a
 * patient name, and returns its date normalized to M/D/YYYY for grouping.
 * Takes the raw cell value (not a pre-stringified one) because some of
 * these attendance sheets store the heading as an actual Date cell (e.g.
 * Jackson Heights Attendance) rather than decorated text like flush
 * attendance's "March 16,2026(MON.) (billed)" or "08/21/26(FRI.)" —
 * stringifying a Date first would turn it into its default
 * "Sat Aug 15 2026 00:00:00 GMT..." form, which matches neither pattern.
 * Returns '' for anything else (patient names, blank rows, "CLOSED").
 */
function parseHeadingDate_(cellValue) {
  if (cellValue instanceof Date) {
    return normalizeDateForCompare_(cellValue);
  }
  var cellText = String(cellValue || '').trim();
  if (!cellText) {
    return '';
  }
  var match = cellText.match(/^([A-Za-z]{3,9}\.?\s+\d{1,2}\s*,\s*\d{4}|\d{1,2}\/\d{1,2}\/\d{2,4})/);
  return match ? normalizeDateForCompare_(match[1]) : '';
}

/**
 * Builds a dedupe key for a payment (from Gemini, or read back off an
 * already-reconciled sheet row) so a freshly-scanned claim can be checked
 * against a row already filled in for the same patient/visit before
 * inserting a second row. Patient name is reduced to a sorted set of words
 * so "Zhou, Xia Fen" and "Xia Fen Zhou" collapse to the same key regardless
 * of comma/order differences between the sheet's historical entries and
 * Gemini's extraction.
 */
function fingerprintPayment_(payment) {
  return [
    normalizeNameForMatch_(payment.patientName),
    normalizeDateForCompare_(payment.paidDate),
    checkNoDigits_(payment.checkNo),
    parseAmount_(payment.amountPaid)
  ].join('|');
}

/**
 * Strips any leading letter prefix off a check/EFT number for comparison
 * purposes, so "C-157186" (flush attendance's convention), "W354266534"
 * (Jackson Heights Attendance's), and a bare "157186" (straight off the
 * EOB) all reduce to the same key regardless of which sheet they came from
 * or whether Gemini's raw extraction happened to include a prefix.
 */
function checkNoDigits_(rawCheckNo) {
  return String(rawCheckNo || '').trim().replace(/^[A-Za-z]+-?/, '').toLowerCase();
}

/**
 * Formats a check/EFT number for writing, applying whatever prefix
 * convention this specific sheet already uses (detected by
 * detectCheckNoPrefix_) rather than a hardcoded one — different offices'
 * ledgers use different conventions (or none), and forcing one sheet's
 * convention onto another would misrepresent the actual check number.
 * Also guarantees the result is a definite text string: Gemini sometimes
 * returns the check number as a raw JSON number, and setValue() with a bare
 * number renders through the cell's existing format — e.g. a currency
 * format would turn 157186 into "$157,186.00".
 */
function formatCheckNo_(rawCheckNo, prefix) {
  var digits = checkNoDigits_(rawCheckNo);
  return digits ? (prefix || '') + digits : '';
}

/**
 * Looks at every existing Check No. value already in the sheet and returns
 * whichever letter prefix (e.g. "C-") is most common there — this sheet's
 * own history is a better guide to its convention than assuming any single
 * office's format applies everywhere (Jackson Heights Attendance, for
 * example, leans toward no prefix at all). Defaults to "C-" only when there
 * is no existing Check No. data anywhere to learn a convention from, since
 * a bare numeric string is otherwise indistinguishable from a real number
 * to Sheets and gets rendered through whatever number format that cell
 * already has — e.g. a currency format turning "157186" into "$157,186.00"
 * even though it was written as text.
 */
function detectCheckNoPrefix_(groups) {
  var counts = {};
  groups.forEach(function (group) {
    group.rows.forEach(function (row) {
      var raw = String(row.checkNo || '').trim();
      if (!raw) {
        return;
      }
      var match = raw.match(/^([A-Za-z]+)-?/);
      var prefix = match ? match[1].toUpperCase() + '-' : '';
      counts[prefix] = (counts[prefix] || 0) + 1;
    });
  });

  var bestPrefix = 'C-';
  var bestCount = -1;
  Object.keys(counts).forEach(function (prefix) {
    if (counts[prefix] > bestCount) {
      bestCount = counts[prefix];
      bestPrefix = prefix;
    }
  });
  return bestPrefix;
}

/**
 * Normalizes a string for case/whitespace-insensitive comparison.
 */
function normalizeText_(value) {
  return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
}

/**
 * Normalizes a patient name to a sorted set of words so "Last, First" and
 * "First Last" (and stray extra spaces around the comma) compare equal —
 * this sheet's historical entries use both conventions interchangeably. A
 * leading list number, e.g. "21. ZHU, XINGJIA" or "9.LAU, TSUENLEUNG", is
 * stripped first — the sheet bakes that numbering into the same cell as
 * the name, but Gemini's extraction never includes it.
 */
function normalizeNameForMatch_(name) {
  var withoutListNumber = String(name || '').replace(/^\s*\d+\.\s*/, '');
  var tokens = normalizeText_(withoutListNumber).replace(/,/g, ' ').split(/\s+/).filter(function (token) {
    return token;
  });
  tokens.sort();
  return tokens.join(' ');
}

/**
 * Strips a name down to just its letters, in original order, with no
 * spacing or punctuation at all. On its own this doesn't tolerate "Last,
 * First" vs "First Last" reordering the way normalizeNameForMatch_ does,
 * but it does catch a different real inconsistency in this sheet: a
 * transliterated given name written as one fused word in some entries and
 * two spaced words in others (e.g. "JINXI" vs "JIN XI", "LONGGUAN" vs
 * "LONG GUAN") — spacing that sorted-word comparison can't paper over
 * because it changes how many tokens there are.
 */
function normalizeNameLettersOnly_(name) {
  var withoutListNumber = String(name || '').replace(/^\s*\d+\.\s*/, '');
  return withoutListNumber.toLowerCase().replace(/[^a-z]/g, '');
}

/**
 * True if two patient names refer to the same person under either
 * tolerance above — sorted-word match (handles reordering) or letters-only
 * match (handles fused/split spelling variants).
 */
function namesMatch_(nameA, nameB) {
  return normalizeNameForMatch_(nameA) === normalizeNameForMatch_(nameB) ||
    normalizeNameLettersOnly_(nameA) === normalizeNameLettersOnly_(nameB);
}

/**
 * Normalizes a date-ish cell value (sheet Date object or Gemini date string)
 * to M/D/YYYY for comparison; falls back to a lowercased string compare
 * when the value can't be parsed as a date.
 */
function normalizeDateForCompare_(value) {
  if (value instanceof Date) {
    return (value.getMonth() + 1) + '/' + value.getDate() + '/' + value.getFullYear();
  }
  var str = String(value || '').trim();
  if (!str) {
    return '';
  }
  var parsed = new Date(str);
  if (!isNaN(parsed.getTime()) && /\d/.test(str)) {
    return (parsed.getMonth() + 1) + '/' + parsed.getDate() + '/' + parsed.getFullYear();
  }
  return str.toLowerCase();
}

/**
 * Strips currency formatting (e.g. "$1,234.56") down to a number so
 * reconciled amounts stay numeric in the sheet; returns the original value
 * unchanged if it can't be parsed as a number.
 */
function parseAmount_(value) {
  if (value === '' || value === null || value === undefined) {
    return '';
  }
  var numeric = parseFloat(String(value).replace(/[^0-9.-]/g, ''));
  return isNaN(numeric) ? value : numeric;
}

/* ---------------------------------------------------------------------
 * Sign-in sheets: reads the patients off a photo of the front desk's
 * sign-in sheet and adds that day's visit rows to an attendance tab, laid
 * out like the tab's latest day, so reconcilePayments can fill in the
 * payment once the EOB arrives. Unlike reconcilePayments this does add
 * rows, but only below the tab's last row (or right after the rows already
 * entered for the same day), and never over a cell that has anything in it.
 * ------------------------------------------------------------------- */

/** How many of a tab's latest patient rows show how it writes names (numbers, commas, capitals). */
var ATTENDANCE_STYLE_ROWS = 40;

/** Most empty rows copied from just above (or just below) a tab's latest date row. */
var ATTENDANCE_MAX_SPACER_ROWS = 4;

/** Month names, for date rows written like "March 16,2026(MON.)". */
var MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
  'August', 'September', 'October', 'November', 'December'];

/** Weekdays, for date rows written like "01/04/24(THU.)". */
var WEEKDAY_NAMES = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];

/** Accented letters and the plain letters they are matched and written as. */
var ACCENTED_LETTERS = {
  '\u00e1': 'a', '\u00e0': 'a', '\u00e4': 'a', '\u00e2': 'a', '\u00e3': 'a', '\u00e5': 'a',
  '\u00e9': 'e', '\u00e8': 'e', '\u00eb': 'e', '\u00ea': 'e',
  '\u00ed': 'i', '\u00ec': 'i', '\u00ef': 'i', '\u00ee': 'i',
  '\u00f3': 'o', '\u00f2': 'o', '\u00f6': 'o', '\u00f4': 'o', '\u00f5': 'o',
  '\u00fa': 'u', '\u00f9': 'u', '\u00fc': 'u', '\u00fb': 'u',
  '\u00f1': 'n', '\u00e7': 'c'
};

/**
 * Serves SignInSidebar.html in the Google Sheets sidebar.
 */
function showSignInSidebar() {
  var html = HtmlService.createHtmlOutputFromFile('SignInSidebar')
    .setTitle('Sign-in Sheet Scanner')
    .setWidth(340);
  SpreadsheetApp.getUi().showSidebar(html);
}

/**
 * The tab open in the sheet right now, which is where the Sign-in Sheet
 * Scanner adds patients: its name, and whether it is an attendance tab
 * (has the Paid Date / Reason / Check No. / Amount headers that
 * reconcilePayments needs too).
 *
 * @return {{success: boolean, name?: string, isAttendance?: boolean, error?: string}}
 */
function getOpenAttendanceTab() {
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var isAttendance = sheet.getType() === SpreadsheetApp.SheetType.GRID && !!findLedgerColumns_(sheet);
    return { success: true, name: sheet.getName(), isAttendance: isAttendance };
  } catch (error) {
    return { success: false, error: error.message };
  }
}

/**
 * Sends a photo or PDF of a patient sign-in sheet to Gemini and returns the
 * date written on it and the patients who signed in, top to bottom. Nothing
 * is written to the sheet here.
 *
 * @param {string} base64Data Image or PDF data captured from the file input.
 * @return {{success: boolean, date?: string,
 *           patients?: Array<{lastName: string, firstName: string}>, error?: string}}
 */
function processSignInSheet(base64Data) {
  try {
    if (!base64Data) {
      throw new Error('No image data was received.');
    }

    var apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
    if (!apiKey) {
      throw new Error('Gemini API key is not configured. In the Apps Script editor, open Project Settings > Script Properties and add a GEMINI_API_KEY property.');
    }

    var parsedFile = parseDataUrl_(base64Data);

    var prompt = 'This is a photo or scan of a patient sign-in sheet from a physical therapy clinic: a date at ' +
      'the top, and numbered lines where each patient writes their name when they arrive.\n\n' +
      'Return ONLY a JSON object, with no markdown and no other text, shaped exactly like this:\n' +
      '{"date": "MM/DD/YYYY", "patients": [{"lastName": "...", "firstName": "..."}]}\n\n' +
      'Rules:\n' +
      '- "date" is the date written at the top of the sheet, as MM/DD/YYYY, or an empty string if there is none.\n' +
      '- "patients" has one entry for every line with a patient on it, from top to bottom. Skip empty lines, the ' +
      'column headings and anything crossed out.\n' +
      '- Some sheets also have each patient\'s name typed or printed on the line, next to the handwriting. When a ' +
      'line has a typed name, use the typed name, because it is more reliable than the handwriting. A typed name ' +
      'can sit slightly above or below its handwritten line; keep the patients in the order of the lines.\n' +
      '- Typed names on these sheets are usually last name first, so "Garcia Ana Maria" is lastName "Garcia" and ' +
      'firstName "Ana Maria". When it is unclear which part is the last name, use the handwriting on the same ' +
      'line to decide.\n' +
      '- Keep every part of each name, including second last names and middle names. If a name is hard to read, ' +
      'still include it with your best reading; staff check every name before it is added.\n' +
      '- Ignore arrival times, appointment times and the "Appointment With" column.';

    var payload = {
      contents: [
        {
          parts: [
            { text: prompt },
            {
              inline_data: {
                mime_type: parsedFile.mimeType,
                data: parsedFile.data
              }
            }
          ]
        }
      ],
      generationConfig: {
        temperature: 0.1
      }
    };

    var options = {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify(payload),
      muteHttpExceptions: true
    };

    var response = fetchGeminiWithRetry_(GEMINI_API_URL + '?key=' + apiKey, options);
    var responseCode = response.getResponseCode();
    var responseBody = response.getContentText();

    if (responseCode !== 200) {
      var apiErrorMessage = responseBody;
      try {
        var errorJson = JSON.parse(responseBody);
        if (errorJson.error && errorJson.error.message) {
          apiErrorMessage = errorJson.error.message;
        }
      } catch (parseErrorIgnored) {
        // Error body wasn't JSON; fall back to the raw response text.
      }
      throw new Error('Gemini API error (' + responseCode + '): ' + apiErrorMessage);
    }

    var responseData = JSON.parse(responseBody);
    var candidate = responseData.candidates && responseData.candidates[0];
    var textPart = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0];

    if (!textPart || !textPart.text) {
      throw new Error('Gemini did not return any readable text. The photo may be unclear, unreadable, or blocked by safety filters.');
    }

    var cleanedText = textPart.text.replace(/```json/gi, '').replace(/```/g, '').trim();

    var parsed;
    try {
      parsed = JSON.parse(cleanedText);
    } catch (jsonErrorIgnored) {
      throw new Error('Gemini response was not valid JSON: ' + cleanedText);
    }

    var list = Array.isArray(parsed) ? parsed : (parsed && parsed.patients) || [];
    var patients = [];
    list.forEach(function (rawPatient) {
      var patient = normalizeSignInPatient_(rawPatient);
      if (patient) {
        patients.push(patient);
      }
    });

    var visitDate = parseVisitDate_(parsed && !Array.isArray(parsed) ? parsed.date : '');
    var dateFound = visitDate ? formatVisitDate_(visitDate) : '';
    logUsage_('Sign-in scanner', 'Scan sign-in sheet', true, patients.length + ' patient' + (patients.length === 1 ? '' : 's') +
      (dateFound ? ', date ' + dateFound : ', no date found'));
    return { success: true, date: dateFound, patients: patients };

  } catch (error) {
    logUsage_('Sign-in scanner', 'Scan sign-in sheet', false, error.message);
    return { success: false, error: error.message };
  }
}

/**
 * Reads one patient from Gemini's sign-in reply as {lastName, firstName},
 * whatever casing or spacing it used for the keys. A reply that only gave a
 * whole name keeps it as the last name, so it can still be matched.
 */
function normalizeSignInPatient_(rawPatient) {
  if (!rawPatient) {
    return null;
  }
  if (typeof rawPatient !== 'object') {
    rawPatient = { name: rawPatient };
  }
  var byKey = {};
  Object.keys(rawPatient).forEach(function (key) {
    byKey[normalizeKey_(key)] = rawPatient[key];
  });
  var lastName = cleanText_(byKey.lastname || byKey.last || byKey.surname);
  var firstName = cleanText_(byKey.firstname || byKey.first || byKey.givenname);
  if (!lastName && !firstName) {
    lastName = cleanText_(byKey.name || byKey.patientname || byKey.fullname);
  }
  return lastName || firstName ? { lastName: lastName, firstName: firstName } : null;
}

/**
 * Works out, without writing anything, what adding the scanned patients to
 * an attendance tab for one date would do: each patient's name as the tab
 * already spells it (or, for someone not on the tab yet, written the way
 * the tab writes names), their insurance from their last visit there, and
 * whether they are already entered for that date.
 *
 * Each row's status is "found" (same name as a patient on the tab),
 * "close" (a name on the tab a letter or two off, probably the same
 * patient misread), "new" (not on the tab), "already" (already entered
 * for that date) or "twice" (listed twice on this sheet). "already" and
 * "twice" rows are not added.
 *
 * @param {string} sheetName The attendance tab open in the sheet.
 * @param {string} dateText Visit date, e.g. "11/09/2026".
 * @param {Array<{lastName: string, firstName: string}>} patients From processSignInSheet.
 * @return {{success: boolean, sheetName?: string, date?: string, newDay?: boolean, dateRow?: string,
 *           laterDay?: string, rows?: Array<{scanned: string, name: string, insurance: string,
 *           status: string}>, error?: string}}
 */
function previewAttendance(sheetName, dateText, patients) {
  try {
    var visitDate = parseVisitDate_(dateText);
    if (!visitDate) {
      throw new Error('Type the visit date as MM/DD/YYYY.');
    }

    var tab = getAttendanceTab_(sheetName);
    var sameDay = daysOn_(tab, visitDate);
    var enteredThatDay = patientsOn_(sameDay);
    if (!sameDay.length) {
      assertTabIsOpen_(tab);
    }

    var tabPatients = indexTabPatients_(tab);
    var nameOrderVotes = { lastNameFirst: 0, firstNameFirst: 0 };

    var rows = (patients || []).map(function (patient) {
      var lastName = cleanText_(patient && patient.lastName);
      var firstName = cleanText_(patient && patient.firstName);
      var row = {
        scanned: (lastName + ' ' + firstName).trim(),
        name: '',
        insurance: '',
        status: 'new',
        lastName: lastName,
        firstName: firstName
      };

      var match = findTabPatient_(tabPatients, lastName, firstName);
      if (match) {
        row.status = 'found';
        voteNameOrder_(nameOrderVotes, match.name, lastName, firstName);
      } else {
        match = closestTabPatient_(tabPatients, lastName, firstName);
        if (match) {
          row.status = 'close';
        }
      }
      if (match) {
        row.name = match.name;
        row.insurance = cleanText_(match.insurance);
      }
      return row;
    });

    var style = attendanceNameStyle_(tab, nameOrderVotes);
    rows.forEach(function (row) {
      // a close match can't be someone another line on this sheet matched exactly (e.g. two
      // relatives with similar names who both came in); treat it as a new patient instead
      var takenByExactMatch = row.status === 'close' && rows.some(function (other) {
        return other.status === 'found' && samePatientName_(other.name, row.name);
      });
      if (takenByExactMatch) {
        row.status = 'new';
        row.name = '';
        row.insurance = '';
      }
      if (!row.name) {
        row.name = formatNewPatientName_(style, row.lastName, row.firstName);
      }
    });

    var listed = [];
    rows.forEach(function (row) {
      if (enteredThatDay.some(function (entered) {
        return samePatientName_(entered.text, row.name) || samePatientName_(entered.text, row.scanned);
      })) {
        row.status = 'already';
      } else if (listed.some(function (name) { return samePatientName_(name, row.name); })) {
        row.status = 'twice';
      } else {
        listed.push(row.name);
      }
      delete row.lastName;
      delete row.firstName;
    });

    var latestDay = tab.days[tab.days.length - 1];
    var latestDate = latestDay ? parseVisitDate_(latestDay.date) : null;

    return {
      success: true,
      sheetName: tab.sheet.getName(),
      date: formatVisitDate_(visitDate),
      newDay: sameDay.length === 0,
      dateRow: sameDay.length ? '' : attendanceDateRow_(tab, visitDate).text,
      laterDay: latestDate && latestDate.getTime() > visitDate.getTime() ? formatVisitDate_(latestDate) : '',
      rows: rows
    };

  } catch (error) {
    return { success: false, error: error.message };
  }
}

/**
 * Adds the reviewed sign-in rows to an attendance tab for one date: under
 * a new date row below the tab's last row, laid out like the tab's latest
 * day, or, when that date is already on the tab, right after the rows
 * already entered for it. Patients already entered for that date are
 * skipped, so adding the same sheet twice adds nothing the second time.
 * Rows are only written where every cell is empty; if anything is in the
 * way, fresh rows are inserted instead.
 *
 * The patients only go to the tab that is open in the sheet, and only if
 * it is still sheetName, the tab the sidebar checked the list against. If
 * another tab was opened since, nothing is added and switchedTo names it,
 * so the sidebar can check the list again for that tab first.
 *
 * @param {string} sheetName The open tab the sidebar checked the list against.
 * @param {string} dateText Visit date, e.g. "11/09/2026".
 * @param {Array<{name: string, insurance: string}>} entries The rows to add, as reviewed in the sidebar.
 * @return {{success: boolean, sheetName?: string, addedCount?: number, skipped?: string[],
 *           newDay?: boolean, dateRow?: string, firstRow?: number, lastRow?: number,
 *           switchedTo?: string, error?: string}}
 */
function addAttendance(sheetName, dateText, entries) {
  var lock = LockService.getDocumentLock();
  if (!lock.tryLock(30000)) {
    return { success: false, error: 'Someone else is adding to this spreadsheet right now. Wait a moment and click Add again.' };
  }

  try {
    var openTabName = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet().getName();
    if (openTabName !== sheetName) {
      return {
        success: false,
        switchedTo: openTabName,
        error: 'The sheet is now showing the "' + openTabName + '" tab, not "' + sheetName + '", so nothing was added. ' +
          'The list is checked again for the tab you have open; look it over and click Add again.'
      };
    }

    var visitDate = parseVisitDate_(dateText);
    if (!visitDate) {
      throw new Error('Type the visit date as MM/DD/YYYY.');
    }

    var tab = getAttendanceTab_(sheetName);
    var sameDay = daysOn_(tab, visitDate);
    var enteredThatDay = patientsOn_(sameDay);

    var toAdd = [];
    var skipped = [];
    (entries || []).forEach(function (entry) {
      var name = stripListNumber_(cleanText_(entry && entry.name));
      if (!name) {
        return;
      }
      var alreadyThere = enteredThatDay.some(function (entered) { return samePatientName_(entered.text, name); }) ||
        toAdd.some(function (added) { return samePatientName_(added.name, name); });
      if (alreadyThere) {
        skipped.push(name);
      } else {
        toAdd.push({ name: name, insurance: cleanText_(entry && entry.insurance) });
      }
    });

    var result = {
      success: true,
      sheetName: tab.sheet.getName(),
      addedCount: toAdd.length,
      skipped: skipped,
      newDay: sameDay.length === 0
    };
    if (!toAdd.length) {
      return result;
    }

    var style = attendanceNameStyle_(tab, { lastNameFirst: 0, firstNameFirst: 0 });
    var placed;
    if (sameDay.length) {
      placed = addToExistingDay_(tab, sameDay[sameDay.length - 1], toAdd, style);
    } else {
      assertTabIsOpen_(tab);
      placed = addNewDay_(tab, visitDate, toAdd, style);
    }
    SpreadsheetApp.flush();

    result.dateRow = placed.dateRow || '';
    result.firstRow = placed.firstRow;
    result.lastRow = placed.lastRow;
    logUsage_('Sign-in scanner', 'Add sign-in patients', true, 'Tab "' + result.sheetName + '": added ' + toAdd.length +
      ' for ' + formatVisitDate_(visitDate) + (result.newDay ? ' under a new date row' : ' under the date already there') +
      (skipped.length ? ', ' + skipped.length + ' already there' : ''));

    try {
      tab.sheet.activate();
      tab.sheet.getRange(placed.firstRow, tab.nameCol, placed.lastRow - placed.firstRow + 1, 1).activate();
    } catch (selectErrorIgnored) {
      // Showing the new rows is only a convenience.
    }
    return result;

  } catch (error) {
    logUsage_('Sign-in scanner', 'Add sign-in patients', false, error.message);
    return { success: false, error: error.message };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Finds the attendance tab the sidebar names and reads it. Refuses a tab
 * that reconcilePayments couldn't post to either.
 */
function getAttendanceTab_(sheetName) {
  var sheet = sheetName ? SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName) : null;
  if (!sheet) {
    throw new Error('There is no tab named "' + sheetName + '" anymore. It may have been renamed or deleted; click \u21bb next to the tab list to reload it.');
  }
  var ledger = findLedgerColumns_(sheet);
  if (!ledger) {
    throw new Error('The "' + sheet.getName() + '" tab does not look like an attendance tab: could not find Paid Date / Reason / Check No. / Amount headers in its first ' + LEDGER_HEADER_ROWS + ' rows.');
  }
  return readAttendanceTab_(sheet, ledger);
}

/**
 * Reads an attendance tab into its days (each date row, see
 * parseHeadingDate_, with the patient rows under it) and its patient rows in
 * sheet order. Also keeps the name column by row, so a new day can copy the
 * layout around the latest one.
 */
function readAttendanceTab_(sheet, ledger) {
  var startRow = ledger.dataStartRow;
  var rowCount = Math.max(0, ledger.lastRow - startRow + 1);
  var values = rowCount ? sheet.getRange(startRow, 1, rowCount, ledger.lastCol).getValues() : [];
  var shown = rowCount ? sheet.getRange(startRow, ledger.nameCol, rowCount, 1).getDisplayValues() : [];

  var tab = {
    sheet: sheet,
    nameCol: ledger.nameCol,
    insuranceCol: ledger.insuranceCol,
    lastCol: ledger.lastCol,
    startRow: startRow,
    nameCells: [],
    days: [],
    patients: [],
    lastFilledRow: 0
  };
  var currentDay = null;

  for (var r = 0; r < rowCount; r++) {
    var sheetRow = startRow + r;
    var cell = values[r][ledger.nameCol - 1];
    tab.nameCells.push(cell);
    if (!isNameCellEmpty_(tab, sheetRow)) {
      tab.lastFilledRow = sheetRow;
    }

    var dayDate = parseHeadingDate_(cell);
    if (dayDate) {
      currentDay = { date: dayDate, row: sheetRow, value: cell, shown: shown[r][0], lastRow: sheetRow, patients: [] };
      tab.days.push(currentDay);
      continue;
    }

    var text = cleanText_(cell);
    if (!text || /^closed$/i.test(text)) {
      continue;
    }
    var patient = { row: sheetRow, text: text, insurance: ledger.insuranceCol ? values[r][ledger.insuranceCol - 1] : '' };
    tab.patients.push(patient);
    if (currentDay) {
      currentDay.patients.push(patient);
      currentDay.lastRow = sheetRow;
    }
  }

  return tab;
}

/** True if the tab's name cell on sheetRow is empty. */
function isNameCellEmpty_(tab, sheetRow) {
  var cell = tab.nameCells[sheetRow - tab.startRow];
  return !(cell instanceof Date) && !cleanText_(cell);
}

/** The tab's days whose date row is visitDate. */
function daysOn_(tab, visitDate) {
  var dateKey = normalizeDateForCompare_(visitDate);
  return tab.days.filter(function (day) {
    return day.date === dateKey;
  });
}

/** All patient rows under the given days. */
function patientsOn_(days) {
  var patients = [];
  days.forEach(function (day) {
    patients = patients.concat(day.patients);
  });
  return patients;
}

/**
 * Refuses a tab whose last row is an "END" line (how a finished year's tab
 * gets closed off), since a new day belongs on that year's new tab.
 */
function assertTabIsOpen_(tab) {
  var lastText = tab.lastFilledRow ? cleanText_(tab.nameCells[tab.lastFilledRow - tab.startRow]) : '';
  if (/^[-=_*.\s]*end[-=_*.\s]*$/i.test(lastText)) {
    throw new Error('The "' + tab.sheet.getName() + '" tab ends with an END line, so it is closed. Pick the tab where this office\'s attendance goes now.');
  }
}

/**
 * The tab's patients, newest first, one entry per spelling, each with the
 * insurance from that spelling's latest row that has one.
 */
function indexTabPatients_(tab) {
  var bySpelling = {};
  var index = [];
  for (var i = tab.patients.length - 1; i >= 0; i--) {
    var patient = tab.patients[i];
    var name = stripListNumber_(patient.text);
    var sortedKey = sortedNameKey_(name);
    if (!sortedKey) {
      continue;
    }
    var entry = bySpelling[sortedKey];
    if (!entry) {
      entry = { name: name, sortedKey: sortedKey, letterKey: letterNameKey_(name), insurance: '' };
      bySpelling[sortedKey] = entry;
      index.push(entry);
    }
    if (!entry.insurance && cleanText_(patient.insurance)) {
      entry.insurance = patient.insurance;
    }
  }
  return index;
}

/** The tab patient with the same name as the scanned one, in either order, or null. */
function findTabPatient_(tabPatients, lastName, firstName) {
  var firstNameFirst = firstName + ' ' + lastName;
  var sortedKey = sortedNameKey_(firstNameFirst);
  if (!sortedKey) {
    return null;
  }
  var letterKeys = [letterNameKey_(firstNameFirst), letterNameKey_(lastName + ' ' + firstName)];
  for (var i = 0; i < tabPatients.length; i++) {
    if (tabPatients[i].sortedKey === sortedKey || letterKeys.indexOf(tabPatients[i].letterKey) !== -1) {
      return tabPatients[i];
    }
  }
  return null;
}

/**
 * The tab patient whose name is one letter off the scanned one (two for
 * long names), for a name the handwriting or the scan got slightly wrong;
 * the newest such patient wins a tie. Null when nothing is that close.
 */
function closestTabPatient_(tabPatients, lastName, firstName) {
  var targets = [
    sortedNameKey_(firstName + ' ' + lastName).replace(/ /g, ''),
    letterNameKey_(firstName + ' ' + lastName),
    letterNameKey_(lastName + ' ' + firstName)
  ];
  var length = targets[0].length;
  if (length < 5) {
    return null;
  }
  var best = null;
  var bestDistance = length >= 12 ? 3 : 2; // a match has to be closer than this
  tabPatients.forEach(function (entry) {
    var candidates = [entry.sortedKey.replace(/ /g, ''), entry.letterKey, entry.letterKey];
    for (var i = 0; i < targets.length; i++) {
      if (Math.abs(candidates[i].length - targets[i].length) >= bestDistance) {
        continue;
      }
      var distance = editDistance_(targets[i], candidates[i]);
      if (distance < bestDistance) {
        best = entry;
        bestDistance = distance;
      }
    }
  });
  return best;
}

/** Number of single-letter changes that turn one string into the other. */
function editDistance_(a, b) {
  var previous = [];
  for (var j = 0; j <= b.length; j++) {
    previous.push(j);
  }
  for (var i = 1; i <= a.length; i++) {
    var current = [i];
    for (var k = 1; k <= b.length; k++) {
      var cost = a.charAt(i - 1) === b.charAt(k - 1) ? 0 : 1;
      current.push(Math.min(previous[k] + 1, current[k - 1] + 1, previous[k - 1] + cost));
    }
    previous = current;
  }
  return previous[b.length];
}

/**
 * Counts whether a name the tab already has starts with the patient's last
 * name or first name, to tell how the tab orders names without a comma.
 */
function voteNameOrder_(votes, tabName, lastName, firstName) {
  if (tabName.indexOf(',') !== -1) {
    return;
  }
  var firstWord = foldPatientName_(tabName).split(' ')[0];
  if (firstWord && firstWord === foldPatientName_(lastName).split(' ')[0]) {
    votes.lastNameFirst++;
  } else if (firstWord && firstWord === foldPatientName_(firstName).split(' ')[0]) {
    votes.firstNameFirst++;
  }
}

/**
 * How a tab writes patient names, from its latest patient rows: list
 * numbers ("10. JOHN SMITH"), "LAST,FIRST" with a comma, capitals, and,
 * from the scanned patients already on the tab, which name goes first when
 * there is no comma.
 */
function attendanceNameStyle_(tab, nameOrderVotes) {
  var recent = tab.patients.slice(-ATTENDANCE_STYLE_ROWS).map(function (patient) {
    return patient.text;
  });
  var numbered = recent.filter(function (text) {
    return /^\s*\d+\s*[.)]/.test(text);
  });
  var names = recent.map(stripListNumber_);
  var withComma = names.filter(function (name) {
    return name.indexOf(',') !== -1;
  });
  var capitals = names.filter(function (name) {
    return /[A-Za-z]/.test(name) && name === name.toUpperCase();
  });

  return {
    numbered: numbered.length * 2 > recent.length,
    numberEnd: numbered.filter(function (text) { return /^\s*\d+\s*[.)]\s/.test(text); }).length * 2 >= numbered.length ? '. ' : '.',
    comma: withComma.length * 2 > recent.length,
    commaEnd: withComma.filter(function (name) { return /,\s/.test(name); }).length * 2 > withComma.length ? ', ' : ',',
    capitals: !recent.length || capitals.length >= recent.length * 0.6,
    lastNameFirst: nameOrderVotes.lastNameFirst > nameOrderVotes.firstNameFirst
  };
}

/**
 * A name for a patient who isn't on the tab yet, written the way the tab
 * writes names. Accents are dropped, since EOBs spell names without them
 * and reconcilePayments matches by name.
 */
function formatNewPatientName_(style, lastName, firstName) {
  var last = removeAccents_(lastName);
  var first = removeAccents_(firstName);
  var name;
  if (!last || !first) {
    name = last || first;
  } else if (style.comma) {
    name = last + style.commaEnd + first;
  } else {
    name = style.lastNameFirst ? last + ' ' + first : first + ' ' + last;
  }
  return style.capitals ? name.toUpperCase() : name.toLowerCase().replace(/(^|[\s,'-])([a-z])/g, function (all, before, letter) {
    return before + letter.toUpperCase();
  });
}

/**
 * Puts a new day below the tab's last row: the same empty separator rows
 * the latest day has above its date row, a date row written like the
 * latest one, the same empty rows it has before its first patient, then
 * the patients, each row formatted like its counterpart in the latest day.
 */
function addNewDay_(tab, visitDate, toAdd, style) {
  var sheet = tab.sheet;
  var layout = latestDayLayout_(tab);
  var dateRow = attendanceDateRow_(tab, visitDate);
  var total = layout.spacersAbove.length + 1 + layout.spacersBelow.length + toAdd.length;
  var start = Math.max(tab.lastFilledRow, tab.startRow - 1) + 1;
  makeRoom_(tab, start, total);

  var row = start;
  layout.spacersAbove.forEach(function (templateRow) {
    copyRowFormat_(tab, templateRow, row, row);
    row++;
  });

  var dateRowNumber = row;
  if (layout.dateRow) {
    copyRowFormat_(tab, layout.dateRow, dateRowNumber, dateRowNumber);
  }
  var dateCell = sheet.getRange(dateRowNumber, tab.nameCol);
  dateCell.setValue(dateRow.value);
  if (dateRow.numberFormat) {
    dateCell.setNumberFormat(dateRow.numberFormat);
  }
  row++;

  layout.spacersBelow.forEach(function (templateRow) {
    copyRowFormat_(tab, templateRow, row, row);
    row++;
  });

  writePatientRows_(tab, row, toAdd, style, 1, layout.patientRow);
  return { dateRow: dateRow.text, firstRow: dateRowNumber, lastRow: row + toAdd.length - 1 };
}

/**
 * Adds patients to a day that is already on the tab, in new rows inserted
 * right after its last patient (or its date row), formatted like its last
 * patient row and continuing its list numbers.
 */
function addToExistingDay_(tab, day, toAdd, style) {
  var lastPatient = day.patients[day.patients.length - 1];
  var templateRow = lastPatient ? lastPatient.row : latestDayLayout_(tab).patientRow;
  if (templateRow > day.lastRow) {
    templateRow += toAdd.length; // that row moves down when the new rows go in above it
  }
  var nextNumber = 1;
  day.patients.forEach(function (patient) {
    var number = patient.text.match(/^\s*(\d+)\s*[.)]/);
    nextNumber = Math.max(nextNumber, number ? Number(number[1]) + 1 : nextNumber + 1);
  });

  tab.sheet.insertRowsAfter(day.lastRow, toAdd.length);
  var firstRow = day.lastRow + 1;
  writePatientRows_(tab, firstRow, toAdd, style, nextNumber, templateRow);
  return { firstRow: firstRow, lastRow: firstRow + toAdd.length - 1 };
}

/**
 * Where the tab's latest day sits, so a new day can copy its layout: the
 * empty rows just above its date row (blank or colored separator rows; only
 * when an earlier day sits above them), its date row, the empty rows
 * between its date row and its first patient, and its last patient row.
 */
function latestDayLayout_(tab) {
  var lastPatient = tab.patients[tab.patients.length - 1];
  var layout = { spacersAbove: [], dateRow: 0, spacersBelow: [], patientRow: lastPatient ? lastPatient.row : 0 };
  var day = tab.days[tab.days.length - 1];
  if (!day) {
    return layout;
  }
  layout.dateRow = day.row;

  if (day.patients.length) {
    layout.patientRow = day.patients[day.patients.length - 1].row;
    for (var below = day.row + 1; below < day.patients[0].row && isNameCellEmpty_(tab, below) &&
      layout.spacersBelow.length < ATTENDANCE_MAX_SPACER_ROWS; below++) {
      layout.spacersBelow.push(below);
    }
  }

  var above = [];
  for (var row = day.row - 1; row >= tab.startRow && isNameCellEmpty_(tab, row) &&
    above.length < ATTENDANCE_MAX_SPACER_ROWS; row--) {
    above.unshift(row);
  }
  if (above.length && above[0] > tab.startRow) {
    layout.spacersAbove = above;
  }
  return layout;
}

/**
 * The date row for a new day, written like the tab's latest date row: the
 * same kind of value (a real date cell, or text like "01/04/24(THU.)" or
 * "March 16,2026(MON.)"), without its "(billed)" mark. Text is written with
 * a leading apostrophe so Sheets keeps it as typed instead of turning it
 * into a date. A date cell gets the noon of that day, so it shows the same
 * day in any time zone.
 *
 * @return {{value: (Date|string), text: string, numberFormat: string}}
 */
function attendanceDateRow_(tab, visitDate) {
  var latestDay = tab.days[tab.days.length - 1];
  var text = dateRowTextLike_(latestDay ? cleanText_(latestDay.shown) : '', visitDate);
  if (parseHeadingDate_(text) !== normalizeDateForCompare_(visitDate)) {
    text = formatVisitDate_(visitDate);
  }

  if (latestDay && latestDay.value instanceof Date) {
    var numberFormat = '';
    var latestFormat = String(tab.sheet.getRange(latestDay.row, tab.nameCol).getNumberFormat() || '');
    if (/billed/i.test(latestFormat)) {
      numberFormat = latestFormat.replace(/\s*"[^"]*billed[^"]*"/ig, '');
      if (/billed/i.test(numberFormat) || !numberFormat.trim()) {
        numberFormat = 'mm/dd/yyyy';
      }
    }
    return { value: visitDate, text: text, numberFormat: numberFormat };
  }
  return { value: '\'' + text, text: text, numberFormat: '' };
}

/**
 * Writes visitDate the way the sample date row is written: "01/04/24(THU.)"
 * gives "11/09/26(MON.)" and "March 16,2026(MON.) (billed)" gives
 * "November 09,2026(MON.)", keeping zero-padding, a two- or four-digit
 * year, a short or long month name and the weekday in brackets when the
 * sample has them. Anything else gives MM/DD/YYYY.
 */
function dateRowTextLike_(sample, visitDate) {
  var text = String(sample || '').replace(/\(\s*billed\s*\)/ig, '').replace(/\s+$/, '');
  var month = visitDate.getMonth() + 1;
  var day = visitDate.getDate();
  var year = visitDate.getFullYear();
  var weekday = WEEKDAY_NAMES[visitDate.getDay()];

  var numeric = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4}|\d{2})(\s*\(\s*([A-Za-z]{3,4})(\.?)\s*\))?/);
  if (numeric) {
    var padded = numeric[1].length === 2 || numeric[2].length === 2;
    return (padded ? pad2_(month) : month) + '/' + (padded ? pad2_(day) : day) + '/' +
      (numeric[3].length === 2 ? pad2_(year % 100) : year) +
      (numeric[4] ? weekdayLike_(numeric[4], numeric[5], numeric[6], weekday) : '');
  }

  var written = text.match(/^([A-Za-z]{3,9})(\.?)(\s+)(\d{1,2})(\s*),(\s*)(\d{4})(\s*\(\s*([A-Za-z]{3,4})(\.?)\s*\))?/);
  if (written) {
    var fullName = MONTH_NAMES[month - 1];
    var sampleIsFull = MONTH_NAMES.some(function (name) {
      return name.toLowerCase() === written[1].toLowerCase();
    });
    var monthText = sampleIsFull ? fullName : fullName.slice(0, 3) + written[2];
    if (written[1] === written[1].toUpperCase()) {
      monthText = monthText.toUpperCase();
    }
    return monthText + written[3] + (written[4].length === 2 ? pad2_(day) : day) + written[5] + ',' + written[6] + year +
      (written[8] ? weekdayLike_(written[8], written[9], written[10], weekday) : '');
  }

  return formatVisitDate_(visitDate);
}

/** "(MON.)" for visitDate's weekday, spaced, cased and dotted like the sample "(THU.)". */
function weekdayLike_(sampleWhole, sampleWeekday, sampleDot, weekday) {
  var before = sampleWhole.match(/^\s*/)[0];
  var name = sampleWeekday === sampleWeekday.toUpperCase() ? weekday : weekday.charAt(0) + weekday.slice(1).toLowerCase();
  return before + '(' + name + sampleDot + ')';
}

/**
 * Makes sure rows start..start+count-1 are empty in every column: adds rows
 * at the bottom when the tab is too short, and inserts fresh rows at start
 * when anything is already there, so nothing gets written over.
 */
function makeRoom_(tab, start, count) {
  var sheet = tab.sheet;
  var maxRows = sheet.getMaxRows();
  var existing = Math.max(0, Math.min(count, maxRows - start + 1));
  var inUse = false;
  if (existing > 0) {
    var range = sheet.getRange(start, 1, existing, tab.lastCol);
    var formulas = range.getFormulas();
    inUse = range.getValues().some(function (rowValues, i) {
      return rowValues.some(function (value, j) {
        return cleanText_(value) !== '' || value instanceof Date || !!formulas[i][j];
      });
    });
  }
  if (inUse) {
    sheet.insertRowsBefore(start, count);
  } else if (start + count - 1 > maxRows) {
    sheet.insertRowsAfter(maxRows, start + count - 1 - maxRows);
  }
}

/** Copies one row's formatting (all of the tab's columns) onto rows toFirstRow..toLastRow. */
function copyRowFormat_(tab, fromRow, toFirstRow, toLastRow) {
  tab.sheet.getRange(fromRow, 1, 1, tab.lastCol).copyFormatToRange(tab.sheet, 1, tab.lastCol, toFirstRow, toLastRow);
}

/**
 * Writes the patients from firstRow down: formatting copied from
 * templateRow, the name (numbered from firstNumber when the tab numbers
 * its lists) and, when the tab has an Insurance column, the insurance.
 */
function writePatientRows_(tab, firstRow, toAdd, style, firstNumber, templateRow) {
  var lastRow = firstRow + toAdd.length - 1;
  if (templateRow) {
    copyRowFormat_(tab, templateRow, firstRow, lastRow);
  }
  tab.sheet.getRange(firstRow, tab.nameCol, toAdd.length, 1).setValues(toAdd.map(function (entry, i) {
    var name = (style.numbered ? (firstNumber + i) + style.numberEnd : '') + entry.name;
    return [/^[=+@-]/.test(name) ? '\'' + name : name];
  }));
  if (tab.insuranceCol) {
    tab.sheet.getRange(firstRow, tab.insuranceCol, toAdd.length, 1).setValues(toAdd.map(function (entry) {
      return [/^[=+@-]/.test(entry.insurance) ? '\'' + entry.insurance : entry.insurance];
    }));
  }
}

/**
 * Reads a visit date written as M/D/YY or MM/DD/YYYY (with slashes, dashes or
 * dots) or spelled out, and returns noon of that day, which stays the same
 * calendar day in any time zone. Null for anything else, including
 * impossible dates like 2/30.
 */
function parseVisitDate_(value) {
  if (value instanceof Date) {
    return isNaN(value.getTime()) ? null : new Date(value.getFullYear(), value.getMonth(), value.getDate(), 12);
  }
  var text = cleanText_(value);
  var parts = text.match(/^(\d{1,2})\s*[\/.-]\s*(\d{1,2})\s*[\/.-]\s*(\d{2}|\d{4})$/);
  if (parts) {
    var month = Number(parts[1]);
    var day = Number(parts[2]);
    var year = Number(parts[3]) + (parts[3].length === 2 ? 2000 : 0);
    var date = new Date(year, month - 1, day, 12);
    return date.getMonth() === month - 1 && date.getDate() === day ? date : null;
  }
  var parsed = /\d{4}/.test(text) ? new Date(text) : new Date(NaN);
  return isNaN(parsed.getTime()) ? null : new Date(parsed.getFullYear(), parsed.getMonth(), parsed.getDate(), 12);
}

/** A date as MM/DD/YYYY. */
function formatVisitDate_(date) {
  return pad2_(date.getMonth() + 1) + '/' + pad2_(date.getDate()) + '/' + date.getFullYear();
}

/** A number as at least two digits. */
function pad2_(number) {
  return (number < 10 ? '0' : '') + number;
}

/** A cell value or scanned text as a trimmed single-spaced string ('' for empty or missing). */
function cleanText_(value) {
  if (value === null || value === undefined) {
    return '';
  }
  return String(value).replace(/\s+/g, ' ').trim();
}

/** A name without the list number the sheet puts in front of it ("10. JOHN SMITH"). */
function stripListNumber_(text) {
  return cleanText_(text).replace(/^\d+\s*[.)]\s*/, '');
}

/** Text with accented letters replaced by plain ones ("MU\u00d1OZ" -> "MUNOZ"). */
function removeAccents_(text) {
  return cleanText_(text).replace(/[\u00c0-\u00ff]/g, function (letter) {
    var lower = letter.toLowerCase();
    var plain = ACCENTED_LETTERS[lower];
    if (!plain) {
      return letter;
    }
    return letter === lower ? plain : plain.toUpperCase();
  });
}

/**
 * A name reduced for matching: list number, accents, punctuation and
 * capitals dropped ("21. MU\u00d1OZ-LOPEZ, Ana" -> "munoz lopez ana").
 */
function foldPatientName_(name) {
  return removeAccents_(stripListNumber_(name)).toLowerCase().replace(/[^a-z]+/g, ' ').trim();
}

/** The words of a name in sorted order, so "Last, First" and "First Last" give the same key. */
function sortedNameKey_(name) {
  return foldPatientName_(name).split(' ').sort().join(' ');
}

/** Just the letters of a name in order, so "ANA MARIA" and "ANAMARIA" give the same key. */
function letterNameKey_(name) {
  return foldPatientName_(name).replace(/ /g, '');
}

/** True if two names are the same patient under either key. Empty names never match. */
function samePatientName_(nameA, nameB) {
  var sortedA = sortedNameKey_(nameA);
  if (!sortedA) {
    return false;
  }
  return sortedA === sortedNameKey_(nameB) || letterNameKey_(nameA) === letterNameKey_(nameB);
}

/* ---------------------------------------------------------------------
 * Usage log: one row per EOB scan, reconcile, sign-in scan and sign-in
 * add on a "Scanner Log" tab, with totals for this month and all time at
 * the top, to see how much the scanners get used. It only records counts,
 * tab names and error messages, never patient names.
 * ------------------------------------------------------------------- */

/** The tab the usage log is kept on (made the first time something is logged). */
var USAGE_LOG_TAB = 'Scanner Log';

/** The row of the log's first entry; above it are a title, the totals and the column headings. */
var USAGE_LOG_FIRST_ROW = 10;

/** The kinds of use counted in the totals, as written in the log's "What" column. */
var USAGE_LOG_ACTIONS = ['Scan EOB', 'Reconcile', 'Scan sign-in sheet', 'Add sign-in patients'];

/**
 * Opens the Scanner Log tab (from the menu), making it first if nothing
 * has been logged yet.
 */
function showUsageLog() {
  getUsageLog_(SpreadsheetApp.getActiveSpreadsheet()).activate();
}

/**
 * Adds one row to the usage log: when, which scanner, what was done,
 * whether it worked, and details such as how many rows. Callers pass only
 * counts, tab names and error messages; an error that quotes Gemini's
 * reply is cut before the reply, since that could hold patient names. A
 * problem with the log itself is ignored: it must never stop a scan or a
 * reconcile.
 */
function logUsage_(scanner, what, worked, details) {
  try {
    var text = String(details || '').replace(/(not valid JSON)[\s\S]*$/, '$1');
    if (text.length > 200) {
      text = text.slice(0, 197) + '...';
    }
    getUsageLog_(SpreadsheetApp.getActiveSpreadsheet())
      .appendRow([new Date(), scanner, what, worked ? 'Worked' : 'Failed', text]);
  } catch (logErrorIgnored) {
    // the scan or reconcile matters more than its log entry
  }
}

/**
 * The Scanner Log tab, made the first time it is needed, after the last
 * tab: a title, the totals for each kind of use (this month and all time,
 * counting the uses that worked) and the column headings, all above
 * USAGE_LOG_FIRST_ROW. Whoever is using a scanner stays on the tab they
 * had open.
 */
function getUsageLog_(spreadsheet) {
  var log = spreadsheet.getSheetByName(USAGE_LOG_TAB);
  if (log) {
    return log;
  }

  var openTab = spreadsheet.getActiveSheet();
  log = spreadsheet.insertSheet(USAGE_LOG_TAB, spreadsheet.getNumSheets());

  log.getRange(1, 1).setValue('Scanner usage').setFontWeight('bold').setFontSize(12);
  log.getRange(2, 1).setValue('One row per use, newest at the bottom. The totals count the uses that worked. ' +
    'Patient names are never logged.').setFontColor('#6b7280');
  log.getRange(3, 1, 1, 3).setValues([['What', 'This month', 'All time']]).setFontWeight('bold');

  var first = USAGE_LOG_FIRST_ROW;
  log.getRange(4, 1, USAGE_LOG_ACTIONS.length, 3).setValues(USAGE_LOG_ACTIONS.map(function (action, i) {
    var worked = '$C$' + first + ':$C,$A' + (4 + i) + ',$D$' + first + ':$D,"<>Failed"';
    return [
      action,
      '=COUNTIFS(' + worked + ',$A$' + first + ':$A,">="&EOMONTH(TODAY(),-1)+1)',
      '=COUNTIFS(' + worked + ')'
    ];
  }));

  log.getRange(first - 1, 1, 1, 5).setValues([['When', 'Scanner', 'What', 'Result', 'Details']])
    .setFontWeight('bold').setBackground('#e6f4f7');
  log.getRange(first, 1, log.getMaxRows() - first + 1, 1).setNumberFormat('m/d/yyyy h:mm am/pm');
  [150, 110, 160, 70, 420].forEach(function (width, i) {
    log.setColumnWidth(i + 1, width);
  });

  if (openTab) {
    openTab.activate();
  }
  return log;
}
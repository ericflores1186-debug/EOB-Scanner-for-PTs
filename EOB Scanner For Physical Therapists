var GEMINI_MODEL = 'gemini-3.1-flash-lite';
var GEMINI_API_URL = 'https://generativelanguage.googleapis.com/v1beta/models/' + GEMINI_MODEL + ':generateContent';

/** Gemini reply codes that mean it is busy or briefly unavailable, so the request is worth sending again. */
var GEMINI_RETRY_CODES = [429, 500, 502, 503, 504];

/** Seconds to wait before each new try while Gemini is busy: up to 4 tries over about 17 seconds. */
var GEMINI_RETRY_WAIT_SECONDS = [2, 5, 10];


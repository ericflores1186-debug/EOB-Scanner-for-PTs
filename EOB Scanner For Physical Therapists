    .setWidth(340);
  SpreadsheetApp.getUi().showSidebar(html);
}

// Both scanners go through this. base64Data is the data: URL the sidebar builds with
// FileReader, so it can be a png/jpg or a pdf. Gives back the parsed JSON from Gemini.
function callGemini_(prompt, base64Data) {
  if (!base64Data) {
    throw new Error('No image data was received.');
  }

  var apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  if (!apiKey) {
    throw new Error('Gemini API key is not configured. In the Apps Script editor, open Project Settings > Script Properties and add a GEMINI_API_KEY property.');
  }

  // "data:application/pdf;base64,AAAA..." -> mime type + the raw base64.
  // No prefix at all? assume it's a png.
  var dataUrl = /^data:([a-zA-Z0-9.+-]+\/[a-zA-Z0-9.+-]+);base64,/;
  var found = base64Data.match(dataUrl);
  var mimeType = found ? found[1] : 'image/png';
  var rawData = base64Data.replace(dataUrl, '');

  var response = UrlFetchApp.fetch(GEMINI_API_URL + '?key=' + apiKey, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify({
      contents: [{
        parts: [
          { text: prompt },
          { inline_data: { mime_type: mimeType, data: rawData } }
        ]
      }],
      generationConfig: { temperature: 0.1 }
    }),
    muteHttpExceptions: true
  });

  var code = response.getResponseCode();
  var body = response.getContentText();

  if (code !== 200) {
    var msg = body;
    try {
      var err = JSON.parse(body);
      if (err.error && err.error.message) {
        msg = err.error.message;
      }
    } catch (e) {
      // body wasn't json, just show it as is
    }
    throw new Error('Gemini API error (' + code + '): ' + msg);
  }

  var reply = JSON.parse(body);
  var candidate = reply.candidates && reply.candidates[0];
  var part = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0];
  if (!part || !part.text) {
    throw new Error('Gemini did not return any readable text. The image may be unclear, unreadable, or blocked by safety filters.');
  }

  // sometimes it wraps the json in ``` fences even when told not to
  var text = part.text.replace(/```json/gi, '').replace(/```/g, '').trim();
  try {
    return JSON.parse(text);
  } catch (e) {
    throw new Error('Gemini response was not valid JSON: ' + text);
  }
}

function normalizeKey_(key) {
  return String(key).toLowerCase().replace(/[^a-z0-9]/g, '');
}

// Gemini doesn't always spell the keys the way I asked ("Patient Name" / "patient_name" /
// "patientName"), so match on the normalized key instead of the exact one.
function fieldPicker_(raw) {
  var byKey = {};
  Object.keys(raw || {}).forEach(function (k) {
    byKey[normalizeKey_(k)] = raw[k];
  });

  // pick('Paid Date', 'Check Date') -> first one that actually has something in it
  return function () {
    for (var i = 0; i < arguments.length; i++) {
      var v = byKey[normalizeKey_(arguments[i])];
      if (v !== undefined && v !== null && v !== '') return v;
    }
    return '';
  };
}


// ---- authorization scanner ----

function processImage(base64Data) {
  try {
    var prompt = 'Analyze this insurance authorization document (a screenshot or a PDF). Extract the Patient Name, Member ID, Auth Number, Approved Visits, Start Date, and End Date. Return ONLY a valid, raw JSON object with these keys (no markdown formatting, no backticks).';
    var parsed = callGemini_(prompt, base64Data);
    return { success: true, data: normalizeExtractedData_(parsed) };
  } catch (e) {
    return { success: false, error: e.message };
  }
}

function normalizeExtractedData_(raw) {
  var pick = fieldPicker_(raw);
  return {
    patientName: pick('Patient Name', 'name'),
    memberId: pick('Member ID'),
    authNumber: pick('Auth Number', 'Authorization Number'),
    approvedVisits: pick('Approved Visits', 'visits'),
    startDate: pick('Start Date', 'Effective Date'),
    endDate: pick('End Date', 'Expiration Date')
  };
}

// adds a header row first if the sheet is completely empty
function appendData(patientData) {
  try {
    if (!patientData || !String(patientData.patientName || '').trim()) {
      throw new Error('Patient Name is required before saving.');
    }

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    if (sheet.getLastRow() === 0) {
      var headers = ['Patient Name', 'Member ID', 'Auth Number', 'Approved Visits', 'Start Date', 'End Date'];
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    }

    sheet.appendRow([
      patientData.patientName || '',
      patientData.memberId || '',
      patientData.authNumber || '',
      patientData.approvedVisits || '',
      patientData.startDate || '',
      patientData.endDate || ''
    ]);

    return { success: true };
  } catch (e) {
    return { success: false, error: e.message };
  }
}


// ---- EOB scanner ----

function processEOBImage(base64Data) {
  try {
    var prompt = 'This is an insurance EOB / remittance advice, provided as either a single image or a PDF that ' +
      'may span multiple pages - if there is more than one page, extract claims from every page. The ' +
      'payer/insurance company name is shown once near the top (e.g. a company name and address block). It lists ' +
      'one or more patient claims. Each claim starts with a line like "NAME: <Last, First>" and may show ' +
      'HIC/ACNT/ICN numbers, then one or more procedure-code line items (each with its own SERV DATE, an ' +
      'adjustment/reason code such as CO-197, CO-45, or CO-209, and a PROV PD amount), followed by a row labeled ' +
      '"CLAIM TOTALS" that sums those procedure lines, and then usually a separate "Adj to Totals" line below that ' +
      'with its own PREV PD / INTEREST / NET figures - CLAIM TOTALS and NET are two different numbers and must not ' +
      'be confused for each other. A single Date and Check/EFT number are also shown once near the top of each ' +
      'page. The payer name, Date, and Check/EFT number apply to every claim on the same page as them.\n\n' +
      'Return ONLY a raw JSON array of objects (no markdown formatting, no backticks, no surrounding text), with ' +
      'ONE object per claim - that is, per patient per service date. If the same patient name appears in two ' +
      'separate claim blocks with different service dates, treat them as two separate objects; if one claim has ' +
      'several procedure-code lines, combine them into a single object. Each object must have these keys, and ' +
      'every value must be a JSON string even if it looks like a number (e.g. "checkNo": "157186", not 157186):\n' +
      '- patientName: the NAME field, formatted exactly as printed (typically "Last, First Middle")\n' +
      '- serviceDate: the SERV DATE for this claim\n' +
      '- insurance: the payer/insurance company name shown near the top of that page\n' +
      '- paidDate: the Date shown once near the top of that page\n' +
      '- checkNo: the Check/EFT number shown once near the top of that page, digits only, with no letter prefix ' +
      '(e.g. "157186", not "C-157186")\n' +
      '- reasonCode: every distinct adjustment/reason code that appears anywhere in this claim\'s procedure lines, ' +
      'joined with ", " (empty string if none appear)\n' +
      '- amountPaid: the paid-amount figure on this claim\'s CLAIM TOTALS row specifically - the sum of the PROV ' +
      'PD column across its procedure lines. Do NOT use the NET figure from the separate "Adj to Totals" line, ' +
      'even when one is shown and even if the two numbers happen to look close. If there is no CLAIM TOTALS row at ' +
      'all, sum the PROV PD amounts across that claim\'s procedure lines yourself instead\n\n' +
      'Use an empty string for any value that is not present.';

    var parsed = callGemini_(prompt, base64Data);
    if (!Array.isArray(parsed)) parsed = [parsed];

    return { success: true, data: parsed.map(normalizeEOBRow_) };
  } catch (e) {
    return { success: false, error: e.message };
  }
}

function normalizeEOBRow_(raw) {
  var pick = fieldPicker_(raw);
  return {
    patientName: pick('Patient Name', 'name'),
    serviceDate: pick('Service Date', 'Date of Service', 'DOS'),
    insurance: pick('Insurance', 'Insurance Company', 'Payer'),
    paidDate: pick('Paid Date', 'Date/Check EFT Date', 'Check EFT Date', 'Check Date'),
    checkNo: String(pick('Check No.', 'Check/EFT Number') || '').trim(),
    reasonCode: pick('Reason Code', 'Reason'),
    amountPaid: pick('Amount Paid', 'PROV PD', 'Amount')
  };
}


// "$1,234.56" -> 1234.56 so the amount column stays a number. Leaves it alone if it isn't one.
function parseAmount_(value) {
  if (value === '' || value === null || value === undefined) return '';
  const n = parseFloat(String(value).replace(/[^0-9.-]/g, ''));
  return isNaN(n) ? value : n;
}

// turns a date cell or a string like "07/16/26" into M/D/YYYY so two dates can be compared
function normalizeDateForCompare_(value) {
  if (value instanceof Date) {
    return (value.getMonth() + 1) + '/' + value.getDate() + '/' + value.getFullYear();
  }
  const str = String(value || '').trim();
  if (!str) return '';

  const d = new Date(str);
  if (!isNaN(d.getTime()) && /\d/.test(str)) {
    return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
  }
  return str.toLowerCase();
}


// Fills in Paid Date / Reason / Check No. / Amount (and Insurance if it's blank) for the
// payments the sidebar scanned.
//
// The attendance tabs are laid out like this: a date heading in column A ("08/21/26(FRI.)"
// or "March 16,2026(MON.)"), then one row per patient under it. Whoever logs the visit types
// the name + insurance that day and the payment columns stay empty until the EOB comes in.
// So this never adds rows, it only fills in ones that are still blank.
//
// Returns counts for the sidebar:
//   updatedCount    rows we filled in
//   duplicateCount  row already has this exact payment (same EOB scanned twice)
//   conflicts       row already has different payment info, left alone
//   unresolved      no row found for that name + service date
function reconcilePayments(payments) {
  try {
    if (!payments || !payments.length) {
      throw new Error('No payment records to reconcile.');
    }

    const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const lastCol = sheet.getLastColumn();
    const lastRow = sheet.getLastRow();

    if (lastCol < 1 || lastRow < 2) {
      throw new Error('The active sheet does not look like the Flush Attendance ledger (expected a header row followed by data).');
    }

    // Find the columns by their header text so any tab with the same headings works.
    // The headers are in row 1 on some tabs and row 2 on others, so look at the first few rows.
    // The name column usually has no label at all (it's just column A), so that's the fallback.
    let nameCol, paidCol, reasonCol, checkCol, amountCol, insuranceCol;
    let lastHeaderRow = 1;
    const headerRows = Math.min(4, lastRow);
    const hdr = sheet.getRange(1, 1, headerRows, lastCol).getValues();

    for (let r = 0; r < hdr.length; r++) {
      for (let c = 0; c < lastCol; c++) {
        const key = normalizeKey_(hdr[r][c]); // lowercase, no punctuation
        if (!key) continue;

        let isHeader = true;
        if (!nameCol && (key === 'patientname' || key === 'patient' || key === 'name')) {
          nameCol = c + 1;
        } else if (!paidCol && key === 'paiddate') {
          paidCol = c + 1;
        } else if (!reasonCol && (key === 'reason' || key === 'reasoncode')) {
          reasonCol = c + 1;
        } else if (!checkCol && key === 'checkno') {
          checkCol = c + 1;
        } else if (!amountCol && (key === 'amount' || key === 'amountpaid')) {
          amountCol = c + 1;
        } else if (!insuranceCol && key === 'insurance') {
          insuranceCol = c + 1;
        } else {
          isHeader = false;
        }
        if (isHeader) lastHeaderRow = Math.max(lastHeaderRow, r + 1);
      }
    }

    nameCol = nameCol || 1;

    if (!paidCol || !reasonCol || !checkCol || !amountCol) {
      throw new Error('Could not find Paid Date / Reason / Check No. / Amount headers in the first ' + headerRows + ' rows of the active sheet.');
    }

    const firstDataRow = lastHeaderRow + 1;
    const data = lastRow >= firstDataRow
      ? sheet.getRange(firstDataRow, 1, lastRow - firstDataRow + 1, lastCol).getValues()
      : [];

    // go down the sheet and put each patient row in the group for the date heading above it
    const groups = [];
    let current = null;
    data.forEach(function (row, i) {
      const heading = parseHeadingDate_(row[nameCol - 1]);
      if (heading) {
        current = { date: heading, rows: [] };
        groups.push(current);
        return;
      }

      const name = String(row[nameCol - 1] || '').trim();
      if (!name || /^closed$/i.test(name)) return;

      if (current) {
        current.rows.push({
          sheetRow: firstDataRow + i,
          name: name,
          insurance: insuranceCol ? row[insuranceCol - 1] : '',
          paidDate: row[paidCol - 1],
          checkNo: row[checkCol - 1],
          amount: row[amountCol - 1]
        });
      }
    });

    const byDate = {};
    groups.forEach(function (g) {
      (byDate[g.date] = byDate[g.date] || []).push(g);
    });

    const checkPrefix = detectCheckNoPrefix_(groups);

    let updated = 0;
    let duplicates = 0;
    const conflicts = [];
    const unresolved = [];

    payments.forEach(function (p) {
      const who = p.patientName || '(blank name)';
      const when = p.serviceDate || '(blank date)';
      const candidates = byDate[normalizeDateForCompare_(p.serviceDate)];

      if (!candidates || !candidates.length) {
        unresolved.push(who + ' - no ' + when + ' section found');
        return;
      }

      // look at every row for this patient under that date
      const mine = fingerprintPayment_(p);
      let blank = null;
      let sawFilled = false;
      let sameAsExisting = false;

      candidates.forEach(function (g) {
        g.rows.forEach(function (row) {
          if (!namesMatch_(row.name, p.patientName)) return;

          if (!(row.paidDate || row.checkNo || row.amount)) {
            blank = blank || row;
            return;
          }

          sawFilled = true;
          const existing = fingerprintPayment_({ patientName: row.name, paidDate: row.paidDate, checkNo: row.checkNo, amountPaid: row.amount });
          if (existing === mine) sameAsExisting = true;
        });
      });

      if (blank) {
        // only ever write into a row that's still blank. Anything already filled in
        // (same payment or a different one) gets reported and left alone.
        const at = blank.sheetRow;
        const checkNo = formatCheckNo_(p.checkNo, checkPrefix);
        const amount = parseAmount_(p.amountPaid);

        sheet.getRange(at, paidCol).setValue(p.paidDate || '');
        sheet.getRange(at, reasonCol).setValue(p.reasonCode || '');
        sheet.getRange(at, checkCol).setValue(checkNo);
        sheet.getRange(at, amountCol).setValue(amount);
        if (insuranceCol && !blank.insurance) {
          sheet.getRange(at, insuranceCol).setValue(p.insurance || '');
        }

        // remember what we wrote, so a second payment for the same visit in this batch
        // sees a filled row instead of writing over this one
        blank.paidDate = p.paidDate || '';
        blank.checkNo = checkNo;
        blank.amount = amount;
        updated++;
      } else if (sameAsExisting) {
        duplicates++;
      } else if (sawFilled) {
        conflicts.push(who + ' on ' + when + ' already has different payment data recorded - left unchanged');
      } else {
        unresolved.push(who + ' - no matching row found under ' + when);
      }
    });

    return {
      success: true,
      updatedCount: updated,
      duplicateCount: duplicates,
      conflictCount: conflicts.length,
      conflicts: conflicts,
      unresolvedCount: unresolved.length,
      unresolved: unresolved
    };
  } catch (e) {
    return { success: false, error: e.message };
  }
}

// Headings look like "08/21/26(FRI.)" or "March 16,2026(MON.) (billed)", and on some tabs
// (Jackson Heights) they're real date cells. Gives back M/D/YYYY, or '' if it's not a heading.
function parseHeadingDate_(cell) {
  if (cell instanceof Date) return normalizeDateForCompare_(cell);

  const text = String(cell || '').trim();
  const m = text.match(/^([A-Za-z]{3,9}\.?\s+\d{1,2}\s*,\s*\d{4}|\d{1,2}\/\d{1,2}\/\d{2,4})/);
  return m ? normalizeDateForCompare_(m[1]) : '';
}

// one string per payment so a scanned claim can be compared to what's already on a row
function fingerprintPayment_(p) {
  return [
    normalizeNameForMatch_(p.patientName),
    normalizeDateForCompare_(p.paidDate),
    checkNoDigits_(p.checkNo),
    parseAmount_(p.amountPaid)
  ].join('|');
}

// C-157186, W354266534 and a plain 157186 all boil down to the same digits
function checkNoDigits_(raw) {
  return String(raw || '').trim().replace(/^[A-Za-z]+-?/, '').toLowerCase();
}

// On the flush tab check numbers look like "C-157186". A bare "157186" can end up formatted
// like currency by the column ($157,186.00), so it always gets a prefix.
function formatCheckNo_(raw, prefix) {
  const digits = checkNoDigits_(raw);
  return digits ? (prefix || '') + digits : '';
}

// Other offices don't use C-. Jackson Heights mostly has no prefix, some W and V. So look at
// what's already on the sheet and copy whichever is most common. Nothing there yet -> "C-".
function detectCheckNoPrefix_(groups) {
  const counts = {};
  groups.forEach(function (g) {
    g.rows.forEach(function (row) {
      const raw = String(row.checkNo || '').trim();
      if (!raw) return;

      const m = raw.match(/^([A-Za-z]+)-?/);
      const prefix = m ? m[1].toUpperCase() + '-' : '';
      counts[prefix] = (counts[prefix] || 0) + 1;
    });
  });

  let best = 'C-';
  let bestCount = -1;
  Object.keys(counts).forEach(function (prefix) {
    if (counts[prefix] > bestCount) {
      bestCount = counts[prefix];
      best = prefix;
    }
  });
  return best;
}

function normalizeText_(value) {
  return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
}

// Names in the sheet are all over the place: "21. ZHU, XINGJIA", "ZHU XINGJIA", "XINGJIA ZHU".
// Drop the list number and commas, then sort the words so the order doesn't matter.
function normalizeNameForMatch_(name) {
  const noNumber = String(name || '').replace(/^\s*\d+\.\s*/, '');
  return normalizeText_(noNumber).replace(/,/g, ' ').split(/\s+/).filter(Boolean).sort().join(' ');
}

// second chance for JINXI vs JIN XI and LONGGUAN vs LONG GUAN. Sorting words can't fix those
// because the number of words changes.
function normalizeNameLettersOnly_(name) {
  return String(name || '').replace(/^\s*\d+\.\s*/, '').toLowerCase().replace(/[^a-z]/g, '');
}

function namesMatch_(a, b) {
  return normalizeNameForMatch_(a) === normalizeNameForMatch_(b) ||
    normalizeNameLettersOnly_(a) === normalizeNameLettersOnly_(b);
}

<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <style>
    :root {
      --primary: #0f6e84;
      --primary-dark: #0b5566;
      --primary-light: #e6f4f7;
      --accent: #2f9e8f;
      --accent-dark: #268a7d;
      --text: #1f2937;
      --text-muted: #6b7280;
      --border: #d8e3e6;
      --success-bg: #e6f6ee;
      --success-text: #1b7f4d;
      --warning-bg: #fff4e5;
      --warning-text: #8a4b00;
      --error-bg: #fdecea;
      --error-text: #b3261e;
      --bg: #f4f8f9;
      --card-bg: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 13px;
    }

    .header {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff;
      padding: 16px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header svg {
      flex-shrink: 0;
    }

    .header h1 {
      font-size: 14px;
      line-height: 1.35;
      margin: 0;
      font-weight: 600;
    }

    .container {
      padding: 14px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 14px;
      box-shadow: 0 1px 3px rgba(15, 110, 132, 0.08);
    }

    .card h2 {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--primary);
      margin: 0 0 10px;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .step-badge {
      background: var(--primary);
      color: #fff;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      flex-shrink: 0;
    }

    .hint {
      margin: -4px 0 10px;
      font-size: 11.5px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    input[type="file"] {
      width: 100%;
      font-size: 12px;
      padding: 6px 0;
    }

    .preview-img {
      display: none;
      max-width: 100%;
      border-radius: 6px;
      margin-top: 10px;
      border: 1px solid var(--border);
    }

    .file-preview {
      display: none;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--primary-light);
      color: var(--primary-dark);
      font-size: 12.5px;
    }

    .file-preview.visible {
      display: flex;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 6px;
      padding: 9px 12px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.15s ease, opacity 0.15s ease;
    }

    .btn-scan {
      background: var(--accent);
      color: #fff;
      margin-top: 10px;
    }

    .btn-scan:hover:not(:disabled) {
      background: var(--accent-dark);
    }

    .btn-save {
      background: var(--primary);
      color: #fff;
    }

    .btn-save:hover:not(:disabled) {
      background: var(--primary-dark);
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .status {
      display: none;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.4;
    }

    .status.visible {
      display: block;
    }

    .status-info {
      background: var(--primary-light);
      color: var(--primary-dark);
    }

    .status-success {
      background: var(--success-bg);
      color: var(--success-text);
    }

    .status-error {
      background: var(--error-bg);
      color: var(--error-text);
    }

    .spinner {
      display: inline-block;
      width: 10px;
      height: 10px;
      border: 2px solid rgba(255, 255, 255, 0.5);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      margin-right: 6px;
      vertical-align: middle;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Date and tab pickers */

    .field-label {
      display: block;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 4px;
    }

    .date-row,
    .tab-row {
      display: flex;
      gap: 6px;
      align-items: center;
      margin-bottom: 10px;
    }

    .date-row input,
    .open-tab {
      flex: 1;
      min-width: 0;
      font-family: inherit;
      font-size: 13px;
      padding: 7px 8px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--card-bg);
      color: var(--text);
    }

    .date-row input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--primary-light);
    }

    .open-tab {
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .open-tab.not-attendance {
      color: var(--error-text);
      border-color: #f3c2bd;
      background: var(--error-bg);
    }

    .weekday {
      width: 34px;
      flex-shrink: 0;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .btn-refresh {
      width: auto;
      flex-shrink: 0;
      align-self: stretch;
      padding: 0 11px;
      background: var(--card-bg);
      color: var(--primary);
      border: 1px solid var(--border);
      font-size: 15px;
      font-weight: 400;
    }

    .btn-refresh:hover:not(:disabled) {
      background: var(--primary-light);
    }

    #tabStatus {
      margin-top: 0;
      margin-bottom: 10px;
    }

    /* Patient list */

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      font-size: 11.5px;
    }

    thead th {
      position: sticky;
      top: 0;
      background: var(--primary-light);
      color: var(--primary-dark);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-size: 10px;
      font-weight: 600;
      text-align: left;
      padding: 6px 8px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody td {
      padding: 6px 8px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      color: var(--text);
      vertical-align: top;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    td.patient-cell {
      width: 100%;
      white-space: normal;
    }

    .editable {
      min-height: 15px;
      border-radius: 3px;
      outline: none;
    }

    .editable[data-field="name"] {
      font-weight: 600;
    }

    .insurance-line {
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin-top: 2px;
    }

    .insurance-label {
      font-size: 10px;
      color: var(--text-muted);
    }

    .insurance-line .editable {
      flex: 1;
      min-width: 40px;
      font-size: 11px;
    }

    .editable[contenteditable="true"]:empty::before {
      content: attr(data-placeholder);
      color: #a3acb0;
    }

    .editable[contenteditable="true"]:focus {
      background: var(--primary-light);
      box-shadow: 0 0 0 1px var(--accent);
    }

    tr.needs-check td {
      background: #fffaf2;
    }

    tr.skipped td {
      color: var(--text-muted);
    }

    tr.skipped .editable {
      text-decoration: line-through;
    }

    .chip {
      display: inline-block;
      padding: 1px 7px;
      border-radius: 10px;
      font-size: 10.5px;
      font-weight: 600;
    }

    .chip-found {
      background: var(--success-bg);
      color: var(--success-text);
    }

    .chip-close,
    .chip-new {
      background: var(--warning-bg);
      color: var(--warning-text);
    }

    .chip-already,
    .chip-twice {
      background: #eef1f2;
      color: var(--text-muted);
    }

    .scanned {
      margin-top: 2px;
      font-size: 10px;
      line-height: 1.3;
      color: var(--text-muted);
    }

    td.remove-cell {
      padding: 4px 6px;
      text-align: center;
    }

    .remove-row {
      width: auto;
      padding: 0 6px;
      line-height: 18px;
      height: 18px;
      font-size: 13px;
      font-weight: 400;
      background: transparent;
      color: var(--text-muted);
      border-radius: 4px;
    }

    .remove-row:hover {
      background: var(--error-bg);
      color: var(--error-text);
    }

    .empty-state {
      padding: 14px 4px;
      text-align: center;
      color: var(--text-muted);
      font-size: 11.5px;
    }

    .legend {
      margin: 10px 0 0;
      padding: 0;
      list-style: none;
      font-size: 11px;
      line-height: 1.45;
      color: var(--text-muted);
    }

    .legend li {
      margin-bottom: 4px;
    }

    .legend .chip {
      font-size: 10px;
      padding: 0 6px;
      margin-right: 3px;
    }

    .summary {
      margin: -2px 0 10px;
      font-size: 12px;
      line-height: 1.45;
      color: var(--text);
    }
  </style>
</head>
<body>
  <div class="header">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="11" fill="rgba(255,255,255,0.15)"/>
      <path d="M12 6v12M6 12h12" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
    <h1>The Flores Automated PT, Created by Eric R. Flores</h1>
  </div>

  <div class="container">

    <div class="card">
      <h2><span class="step-badge">1</span>Sign-in Sheet</h2>
      <p class="hint">Upload a photo or PDF of the patient sign-in sheet. Gemini reads the date and every patient on it.</p>

      <input type="file" id="fileInput" accept="image/*,application/pdf,.pdf">

      <img id="imagePreview" class="preview-img" alt="Selected sign-in sheet">
      <div id="filePreview" class="file-preview"></div>

      <button type="button" id="scanBtn" class="btn-scan">Scan Sign-in Sheet</button>

      <div id="scanStatus" class="status"></div>
    </div>

    <div class="card">
      <h2><span class="step-badge">2</span>Check the Patients</h2>

      <label class="field-label" for="dateInput">Visit date</label>
      <div class="date-row">
        <input type="text" id="dateInput" placeholder="MM/DD/YYYY" autocomplete="off">
        <span id="weekday" class="weekday"></span>
      </div>

      <span class="field-label">Adds to the tab you have open</span>
      <div class="tab-row">
        <div id="openTab" class="open-tab">Checking...</div>
        <button type="button" id="refreshTabBtn" class="btn-refresh" title="Check which tab is open" aria-label="Check which tab is open">&#8635;</button>
      </div>
      <div id="tabStatus" class="status"></div>

      <p class="hint">Open the attendance tab in the sheet. Each name is matched with the patients already on it. Check every orange row. You can edit the names and the insurance.</p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Patient to add</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="resultsBody"></tbody>
        </table>
      </div>
      <div id="emptyState" class="empty-state">No sign-in sheet scanned yet.</div>
      <div id="previewStatus" class="status"></div>

      <ul class="legend">
        <li><span class="chip chip-found">On tab</span>Same name as a patient already on the tab.</li>
        <li><span class="chip chip-close">Check</span>The tab has a name spelled a little differently. Make sure it is the same patient.</li>
        <li><span class="chip chip-new">New</span>Not on this tab yet. Check the spelling and add the insurance.</li>
        <li><span class="chip chip-already">Already in</span><span class="chip chip-twice">Twice</span>Already entered for this date, or listed twice. Not added.</li>
      </ul>
    </div>

    <div class="card">
      <h2><span class="step-badge">3</span>Add to Sheet</h2>
      <p id="summary" class="summary">Scan a sign-in sheet first.</p>

      <button type="button" id="addBtn" class="btn-save" disabled>Add to Sheet</button>

      <div id="addStatus" class="status"></div>
    </div>

  </div>

  <script>
    var STATUS_LABELS = { found: 'On tab', close: 'Check', 'new': 'New', already: 'Already in', twice: 'Twice' };
    var STATUS_TITLES = {
      found: 'Same name as a patient already on this tab.',
      close: 'The closest name on this tab is shown. Make sure it is the same patient.',
      'new': 'Not on this tab yet. Check the spelling and add the insurance.',
      already: 'Already entered for this date. It will not be added again.',
      twice: 'Listed twice on the sign-in sheet. It will be added once.'
    };
    var NOT_ADDED = { already: true, twice: true };
    var WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    var fileInput = document.getElementById('fileInput');
    var imagePreview = document.getElementById('imagePreview');
    var filePreview = document.getElementById('filePreview');
    var scanBtn = document.getElementById('scanBtn');
    var scanStatus = document.getElementById('scanStatus');
    var dateInput = document.getElementById('dateInput');
    var weekday = document.getElementById('weekday');
    var openTabBox = document.getElementById('openTab');
    var refreshTabBtn = document.getElementById('refreshTabBtn');
    var tabStatus = document.getElementById('tabStatus');
    var resultsBody = document.getElementById('resultsBody');
    var emptyState = document.getElementById('emptyState');
    var previewStatus = document.getElementById('previewStatus');
    var summary = document.getElementById('summary');
    var addBtn = document.getElementById('addBtn');
    var addStatus = document.getElementById('addStatus');

    var busy = false;          // a scan or an add is running
    var readingTab = false;    // asking the sheet which tab is open
    var lastTabRead = 0;       // when that was last asked
    var checkAfterTabRead = false; // check the names once the open tab is known
    var keepAddMessage = false;    // ...and keep the message from the last Add while doing it
    var openTab = null;        // {name, isAttendance}: the tab open in the sheet, once known
    var checking = false;      // the names are being matched with the tab
    var checkRun = 0;          // only the latest check's answer is used
    var scannedPatients = [];  // [{lastName, firstName}] from the last scan
    var checked = null;        // the last check's answer (tab, date, rows)

    // ---- scanning ----

    fileInput.addEventListener('change', function () {
      var file = fileInput.files[0];
      hideStatus(scanStatus);
      imagePreview.src = '';
      imagePreview.style.display = 'none';
      filePreview.className = 'file-preview';
      filePreview.textContent = '';

      if (!file) {
        return;
      }

      if (file.type === 'application/pdf' || /\.pdf$/i.test(file.name)) {
        filePreview.textContent = file.name;
        filePreview.className = 'file-preview visible';
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        imagePreview.src = e.target.result;
        imagePreview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });

    scanBtn.addEventListener('click', function () {
      var file = fileInput.files[0];
      if (!file) {
        showStatus(scanStatus, 'Please choose a photo or PDF of the sign-in sheet first.', 'error');
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        setBusy(true, 'scan');
        showStatus(scanStatus, 'Reading the sign-in sheet with Gemini...', 'info');

        google.script.run
          .withSuccessHandler(onScanSuccess)
          .withFailureHandler(onScanFailure)
          .processSignInSheet(e.target.result);
      };
      reader.onerror = function () {
        showStatus(scanStatus, 'Could not read the selected file.', 'error');
      };
      reader.readAsDataURL(file);
    });

    function onScanSuccess(result) {
      setBusy(false, 'scan');

      if (!result || !result.success) {
        showStatus(scanStatus, 'Scan failed: ' + ((result && result.error) || 'Unknown error while scanning.'), 'error');
        return;
      }

      scannedPatients = result.patients || [];
      if (result.date) {
        dateInput.value = result.date;
      }
      showWeekday();

      var count = scannedPatients.length;
      var found = count + ' patient' + (count === 1 ? '' : 's');
      if (!count) {
        showStatus(scanStatus, 'No patients were found on that sheet.', 'error');
      } else if (!result.date) {
        showStatus(scanStatus, 'Found ' + found + ', but no date. Type the visit date below.', 'error');
      } else {
        showStatus(scanStatus, 'Found ' + found + ' for ' + result.date + '. Check them below.', 'success');
      }
      checkAfterTabRead = true;
      readOpenTab(true);
    }

    function onScanFailure(error) {
      setBusy(false, 'scan');
      showStatus(scanStatus, 'Scan failed: ' + (error && error.message ? error.message : error), 'error');
    }

    // ---- matching the names with the tab ----

    dateInput.addEventListener('input', showWeekday);
    dateInput.addEventListener('change', function () {
      showWeekday();
      checkNames(false);
    });
    // Asks the script how each scanned patient is written on the open tab, and whether they
    // are already entered for that date. keepAddStatus keeps the message from the last add.
    function checkNames(keepAddStatus) {
      var run = ++checkRun;
      checked = null;
      checking = false;
      hideStatus(previewStatus);
      if (!keepAddStatus) {
        hideStatus(addStatus);
      }
      renderRows([]);

      if (!scannedPatients.length) {
        refresh();
        return;
      }
      if (!openTab || !openTab.isAttendance) {
        refresh(); // the tab box says what to do
        return;
      }
      if (!parseDate(dateInput.value)) {
        showStatus(previewStatus, 'Type the visit date as MM/DD/YYYY.', 'error');
        refresh();
        return;
      }

      checking = true;
      showStatus(previewStatus, 'Matching the names with the "' + openTab.name + '" tab...', 'info');
      refresh();

      google.script.run
        .withSuccessHandler(function (result) {
          if (run === checkRun) {
            onChecked(result);
          }
        })
        .withFailureHandler(function (error) {
          if (run === checkRun) {
            onChecked({ success: false, error: error && error.message ? error.message : String(error) });
          }
        })
        .previewAttendance(openTab.name, dateInput.value.trim(), scannedPatients);
    }

    function onChecked(result) {
      checking = false;
      if (!result || !result.success) {
        showStatus(previewStatus, (result && result.error) || 'Could not match the names with the tab.', 'error');
        refresh();
        return;
      }
      checked = result;
      hideStatus(previewStatus);
      renderRows(result.rows || []);
      refresh();
    }

    function renderRows(rows) {
      resultsBody.innerHTML = '';

      rows.forEach(function (row) {
        var tr = document.createElement('tr');
        tr.dataset.status = row.status;
        if (NOT_ADDED[row.status]) {
          tr.className = 'skipped';
        } else if (row.status === 'close' || row.status === 'new') {
          tr.className = 'needs-check';
        }

        var statusTd = document.createElement('td');
        var chip = document.createElement('span');
        chip.className = 'chip chip-' + row.status;
        chip.textContent = STATUS_LABELS[row.status] || row.status;
        chip.title = STATUS_TITLES[row.status] || '';
        statusTd.appendChild(chip);
        tr.appendChild(statusTd);

        // the name, the insurance under it, and for a row to check, what the sign-in sheet said
        var patientTd = document.createElement('td');
        patientTd.className = 'patient-cell';
        patientTd.appendChild(editableCell('name', row.name, 'name'));

        var insuranceLine = document.createElement('div');
        insuranceLine.className = 'insurance-line';
        var insuranceLabel = document.createElement('span');
        insuranceLabel.className = 'insurance-label';
        insuranceLabel.textContent = 'Ins:';
        insuranceLine.appendChild(insuranceLabel);
        insuranceLine.appendChild(editableCell('insurance', row.insurance, 'add insurance'));
        patientTd.appendChild(insuranceLine);

        if ((row.status === 'close' || row.status === 'new') && row.scanned) {
          var scanned = document.createElement('div');
          scanned.className = 'scanned';
          scanned.textContent = 'Sheet says: ' + row.scanned;
          patientTd.appendChild(scanned);
        }
        tr.appendChild(patientTd);

        function editableCell(field, text, placeholder) {
          var cell = document.createElement('div');
          cell.className = 'editable';
          cell.dataset.field = field;
          cell.textContent = text || '';
          if (!NOT_ADDED[row.status]) {
            cell.contentEditable = 'true';
            cell.dataset.placeholder = placeholder;
          }
          return cell;
        }

        var removeTd = document.createElement('td');
        removeTd.className = 'remove-cell';
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-row';
        removeBtn.innerHTML = '&times;';
        removeBtn.title = 'Remove this row';
        removeBtn.addEventListener('click', function () {
          tr.remove();
          refresh();
        });
        removeTd.appendChild(removeBtn);
        tr.appendChild(removeTd);

        resultsBody.appendChild(tr);
      });
    }

    resultsBody.addEventListener('input', refresh);

    // the rows that will be added: not removed, not already entered or listed twice, with a name
    function rowsToAdd() {
      var entries = [];
      Array.prototype.forEach.call(resultsBody.querySelectorAll('tr'), function (tr) {
        if (NOT_ADDED[tr.dataset.status]) {
          return;
        }
        var name = tr.querySelector('[data-field="name"]').textContent.trim();
        if (name) {
          entries.push({ name: name, insurance: tr.querySelector('[data-field="insurance"]').textContent.trim() });
        }
      });
      return entries;
    }

    // ---- adding ----

    addBtn.addEventListener('click', function () {
      var entries = rowsToAdd();
      if (!checked || !entries.length) {
        return;
      }

      setBusy(true, 'add');
      showStatus(addStatus, 'Adding ' + entries.length + ' patient' + (entries.length === 1 ? '' : 's') + ' to "' + checked.sheetName + '"...', 'info');

      google.script.run
        .withSuccessHandler(onAddSuccess)
        .withFailureHandler(onAddFailure)
        .addAttendance(checked.sheetName, checked.date, entries);
    });

    function onAddSuccess(result) {
      setBusy(false, 'add');

      if (result && result.switchedTo) {
        showStatus(addStatus, result.error, 'error');
        checkAfterTabRead = true;
        keepAddMessage = true;
        readOpenTab(true);
        return;
      }
      if (!result || !result.success) {
        showStatus(addStatus, 'Could not add the patients: ' + ((result && result.error) || 'unknown error') + '. Nothing was added.', 'error');
        return;
      }

      var msg;
      if (result.addedCount > 0) {
        msg = 'Added ' + result.addedCount + ' patient' + (result.addedCount === 1 ? '' : 's') + ' to "' + result.sheetName + '"' +
          (result.newDay ? ' under the new date row "' + result.dateRow + '"' : '') +
          ' (rows ' + result.firstRow + ' to ' + result.lastRow + '). They are selected in the sheet.';
      } else {
        msg = 'Nothing was added: everyone was already entered for that date.';
      }
      if (result.skipped && result.skipped.length) {
        msg += ' Already there, so not added again: ' + result.skipped.join(', ') + '.';
      }
      showStatus(addStatus, msg, result.addedCount > 0 ? 'success' : 'info');

      // the list now shows them as already entered
      checkNames(true);
    }

    function onAddFailure(error) {
      setBusy(false, 'add');
      showStatus(addStatus, 'Could not add the patients: ' + (error && error.message ? error.message : error), 'error');
    }

    // ---- page state ----

    function refresh() {
      emptyState.style.display = resultsBody.children.length ? 'none' : 'block';
      emptyState.textContent = scannedPatients.length ? 'No patients to show.' : 'No sign-in sheet scanned yet.';
      showSummary();
      updateControls();
    }

    function showSummary() {
      var count = checked ? rowsToAdd().length : 0;
      var who = count + ' patient' + (count === 1 ? '' : 's');

      if (!scannedPatients.length) {
        summary.textContent = 'Scan a sign-in sheet first.';
      } else if (!checked) {
        summary.textContent = checking ? 'Checking the names...' : 'Check the visit date and the tab above.';
      } else if (!count) {
        summary.textContent = 'Nothing to add: everyone on this sheet is already entered for ' + checked.date + ' on "' + checked.sheetName + '".';
      } else if (checked.newDay) {
        summary.textContent = 'Adds a new date row "' + checked.dateRow + '" with ' + who + ' at the bottom of "' + checked.sheetName + '".' +
          (checked.laterDay ? ' Note: this tab already has a later day (' + checked.laterDay + '), and this one will go below it.' : '');
      } else {
        summary.textContent = checked.date + ' is already on "' + checked.sheetName + '". Adds ' + who + ' under it.';
      }
    }

    // one place that decides which controls can be used right now
    function updateControls() {
      scanBtn.disabled = busy;
      dateInput.disabled = busy;
      refreshTabBtn.disabled = busy || readingTab;
      addBtn.disabled = busy || readingTab || checking || !checked || rowsToAdd().length === 0;
    }

    function setBusy(isBusy, which) {
      busy = isBusy;
      updateControls();

      if (which === 'scan') {
        scanBtn.innerHTML = isBusy ? '<span class="spinner"></span>Scanning...' : 'Scan Sign-in Sheet';
      } else if (which === 'add') {
        addBtn.innerHTML = isBusy ? '<span class="spinner"></span>Adding...' : 'Add to Sheet';
      }
    }

    function showStatus(el, message, type) {
      el.textContent = message;
      el.className = 'status visible status-' + type;
    }

    function hideStatus(el) {
      el.className = 'status';
      el.textContent = '';
    }

    // MM/DD/YYYY or M/D/YY (slashes, dashes or dots) as a Date, or null
    function parseDate(text) {
      var parts = String(text || '').trim().match(/^(\d{1,2})\s*[\/.-]\s*(\d{1,2})\s*[\/.-]\s*(\d{2}|\d{4})$/);
      if (!parts) {
        return null;
      }
      var month = Number(parts[1]);
      var day = Number(parts[2]);
      var year = Number(parts[3]) + (parts[3].length === 2 ? 2000 : 0);
      var date = new Date(year, month - 1, day, 12);
      return date.getMonth() === month - 1 && date.getDate() === day ? date : null;
    }

    function showWeekday() {
      var date = parseDate(dateInput.value);
      weekday.textContent = date ? WEEKDAYS[date.getDay()] : '';
    }

    // ---- the tab open in the sheet ----

    refreshTabBtn.addEventListener('click', function () {
      readOpenTab(true);
    });

    // coming back to the sidebar after clicking around the sheet: see if another tab is open now
    document.documentElement.addEventListener('mouseenter', function () {
      readOpenTab(false);
    });
    window.addEventListener('focus', function () {
      readOpenTab(false);
    });

    // Asks the sheet which tab is open. always=false skips it if it was asked a moment ago.
    function readOpenTab(always) {
      if (readingTab || busy || (!always && Date.now() - lastTabRead < 1000)) {
        return;
      }
      readingTab = true;
      lastTabRead = Date.now();
      updateControls();

      google.script.run
        .withSuccessHandler(onOpenTab)
        .withFailureHandler(function (error) {
          onOpenTab({ success: false, error: error && error.message ? error.message : String(error) });
        })
        .getOpenAttendanceTab();
    }

    function onOpenTab(result) {
      readingTab = false;

      if (!result || !result.success) {
        showStatus(tabStatus, 'Could not see which tab is open: ' + ((result && result.error) || 'unknown error') + '. Click the reload button to try again.', 'error');
        updateControls();
        return;
      }

      var changed = !openTab || openTab.name !== result.name || openTab.isAttendance !== result.isAttendance;
      openTab = { name: result.name, isAttendance: result.isAttendance };
      openTabBox.textContent = result.name;
      openTabBox.title = result.name;
      openTabBox.className = 'open-tab' + (result.isAttendance ? '' : ' not-attendance');
      if (result.isAttendance) {
        hideStatus(tabStatus);
      } else {
        showStatus(tabStatus, '"' + result.name + '" is not an attendance tab. Open the attendance tab in the sheet, then come back here.', 'error');
      }

      if (changed || checkAfterTabRead) {
        checkNames(keepAddMessage);
        checkAfterTabRead = false;
        keepAddMessage = false;
      } else {
        updateControls();
      }
    }

    refresh();
    readOpenTab(true);
  </script>
</body>
</html>

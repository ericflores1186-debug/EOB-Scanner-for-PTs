<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <style>
    :root {
      --primary: #0f6e84;
      --primary-dark: #0b5566;
      --primary-light: #e6f4f7;
      --accent: #2f9e8f;
      --accent-dark: #268a7d;
      --text: #1f2937;
      --text-muted: #6b7280;
      --border: #d8e3e6;
      --success-bg: #e6f6ee;
      --success-text: #1b7f4d;
      --error-bg: #fdecea;
      --error-text: #b3261e;
      --bg: #f4f8f9;
      --card-bg: #ffffff;
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      font-size: 13px;
    }

    .header {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff;
      padding: 16px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header svg {
      flex-shrink: 0;
    }

    .header h1 {
      font-size: 14px;
      line-height: 1.35;
      margin: 0;
      font-weight: 600;
    }

    .container {
      padding: 14px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px;
      margin-bottom: 14px;
      box-shadow: 0 1px 3px rgba(15, 110, 132, 0.08);
    }

    .card h2 {
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--primary);
      margin: 0 0 10px;
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .step-badge {
      background: var(--primary);
      color: #fff;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      flex-shrink: 0;
    }

    .hint {
      margin: -4px 0 10px;
      font-size: 11.5px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    input[type="file"] {
      width: 100%;
      font-size: 12px;
      padding: 6px 0;
    }

    .preview-img {
      display: none;
      max-width: 100%;
      border-radius: 6px;
      margin-top: 10px;
      border: 1px solid var(--border);
    }

    .file-preview {
      display: none;
      align-items: center;
      gap: 8px;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--primary-light);
      color: var(--primary-dark);
      font-size: 12.5px;
    }

    .file-preview.visible {
      display: flex;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 6px;
      padding: 9px 12px;
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.15s ease, opacity 0.15s ease;
    }

    .btn-scan {
      background: var(--accent);
      color: #fff;
      margin-top: 10px;
    }

    .btn-scan:hover:not(:disabled) {
      background: var(--accent-dark);
    }

    .btn-save {
      background: var(--primary);
      color: #fff;
    }

    .btn-save:hover:not(:disabled) {
      background: var(--primary-dark);
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .status {
      display: none;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.4;
    }

    .status.visible {
      display: block;
    }

    .status-info {
      background: var(--primary-light);
      color: var(--primary-dark);
    }

    .status-success {
      background: var(--success-bg);
      color: var(--success-text);
    }

    .status-error {
      background: var(--error-bg);
      color: var(--error-text);
    }

    .spinner {
      display: inline-block;
      width: 10px;
      height: 10px;
      border: 2px solid rgba(255, 255, 255, 0.5);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      margin-right: 6px;
      vertical-align: middle;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Extracted-results table */

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 6px;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      min-width: 720px;
      font-size: 11.5px;
    }

    thead th {
      position: sticky;
      top: 0;
      background: var(--primary-light);
      color: var(--primary-dark);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-size: 10px;
      font-weight: 600;
      text-align: left;
      padding: 6px 8px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody td {
      padding: 6px 8px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      color: var(--text);
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody td[contenteditable="true"]:focus {
      outline: none;
      background: var(--primary-light);
      box-shadow: inset 0 0 0 1px var(--accent);
    }

    td.remove-cell {
      padding: 4px 6px;
      text-align: center;
    }

    .remove-row {
      width: auto;
      padding: 0 6px;
      line-height: 18px;
      height: 18px;
      font-size: 13px;
      font-weight: 400;
      background: transparent;
      color: var(--text-muted);
      border-radius: 4px;
    }

    .remove-row:hover {
      background: var(--error-bg);
      color: var(--error-text);
    }

    .empty-state {
      padding: 14px 4px;
      text-align: center;
      color: var(--text-muted);
      font-size: 11.5px;
    }

    .results-footer {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
    }

    /* Tab picker */

    .field-label {
      display: block;
      font-size: 11.5px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 4px;
    }

    .tab-row {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }

    .tab-row select {
      flex: 1;
      min-width: 0;
      font-family: inherit;
      font-size: 13px;
      padding: 7px 8px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--card-bg);
      color: var(--text);
    }

    .tab-row select:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--primary-light);
    }

    .btn-refresh {
      width: auto;
      flex-shrink: 0;
      padding: 0 11px;
      background: var(--card-bg);
      color: var(--primary);
      border: 1px solid var(--border);
      font-size: 15px;
      font-weight: 400;
    }

    .btn-refresh:hover:not(:disabled) {
      background: var(--primary-light);
    }

    #tabStatus {
      margin-top: 0;
      margin-bottom: 10px;
    }

    /* Check No. / Paid Date fill box (for Inovalon lists, which don't show them) */

    .fill-box {
      display: none;
      margin-top: 10px;
      padding: 10px;
      border: 1px dashed var(--border);
      border-radius: 8px;
      background: var(--bg);
    }

    .fill-box.visible {
      display: block;
    }

    .missing-note {
      font-size: 12px;
      font-weight: 600;
      color: var(--error-text);
      margin-bottom: 6px;
    }

    .fill-box .hint {
      margin: 0 0 8px;
    }

    .fill-row {
      display: flex;
      gap: 6px;
      margin-bottom: 8px;
    }

    .fill-row input {
      flex: 1;
      min-width: 0;
      font-family: inherit;
      font-size: 13px;
      padding: 7px 8px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--card-bg);
      color: var(--text);
    }

    .fill-row input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--primary-light);
    }

    .btn-fill {
      background: var(--card-bg);
      color: var(--primary);
      border: 1px solid var(--primary);
    }

    .btn-fill:hover:not(:disabled) {
      background: var(--primary-light);
    }
  </style>
</head>
<body>
  <div class="header">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="11" fill="rgba(255,255,255,0.15)"/>
      <path d="M12 6v12M6 12h12" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
    <h1>The Flores Automated PT, Created by Eric R. Flores</h1>
  </div>

  <div class="container">

    <div class="card">
      <h2><span class="step-badge">1</span>EOB Scanner</h2>
      <p class="hint">Upload a screenshot or PDF of the EOB / remittance advice and let Gemini pull out every payment line.</p>

      <input type="file" id="fileInput" accept="image/*,application/pdf,.pdf">

      <img id="imagePreview" class="preview-img" alt="Selected EOB preview">
      <div id="filePreview" class="file-preview"></div>

      <button type="button" id="scanBtn" class="btn-scan">Scan EOB</button>

      <div id="scanStatus" class="status"></div>
    </div>

    <div class="card">
      <h2><span class="step-badge">2</span>Extracted Payments</h2>
      <p class="hint">Review each line below — cells are editable — and remove any row that shouldn't be posted.</p>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Patient Name</th>
              <th>Service Date</th>
              <th>Insurance</th>
              <th>Paid Date</th>
              <th>Check No.</th>
              <th>Reason</th>
              <th>Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="resultsBody"></tbody>
        </table>
      </div>
      <div id="emptyState" class="empty-state">No payments scanned yet.</div>

      <div id="fillBox" class="fill-box">
        <div id="missingNote" class="missing-note"></div>
        <p class="hint">Inovalon lists don't show these. Open one patient from this batch in Inovalon, type its check number and payment date here, and click Fill. Only empty cells are filled, so use it when every row is from the same check.</p>
        <div class="fill-row">
          <input type="text" id="fillCheckNo" placeholder="Check No." autocomplete="off" aria-label="Check No. for every row">
          <input type="text" id="fillPaidDate" placeholder="Paid Date" autocomplete="off" aria-label="Paid Date for every row">
        </div>
        <button type="button" id="fillBtn" class="btn-fill">Fill empty Check No. / Paid Date</button>
        <div id="fillStatus" class="status"></div>
      </div>
    </div>

    <div class="card">
      <h2><span class="step-badge">3</span>Reconciliation</h2>
      <p class="hint">Matches each payment to its visit row on the tab you pick, by patient name and service date, and fills in Paid Date, Reason, Check No., and Amount there.</p>

      <label class="field-label" for="tabSelect">Post to tab</label>
      <div class="tab-row">
        <select id="tabSelect" disabled>
          <option value="">Loading tabs…</option>
        </select>
        <button type="button" id="refreshTabsBtn" class="btn-refresh" title="Reload the tab list" aria-label="Reload the tab list" disabled>↻</button>
      </div>
      <div id="tabStatus" class="status"></div>

      <button type="button" id="reconcileBtn" class="btn-save" disabled>Reconcile to Sheet</button>

      <div id="reconcileStatus" class="status"></div>
    </div>

  </div>

  <script>
    var FIELDS = ['patientName', 'serviceDate', 'insurance', 'paidDate', 'checkNo', 'reasonCode', 'amountPaid'];

    var fileInput = document.getElementById('fileInput');
    var imagePreview = document.getElementById('imagePreview');
    var filePreview = document.getElementById('filePreview');
    var scanBtn = document.getElementById('scanBtn');
    var reconcileBtn = document.getElementById('reconcileBtn');
    var scanStatus = document.getElementById('scanStatus');
    var reconcileStatus = document.getElementById('reconcileStatus');
    var resultsBody = document.getElementById('resultsBody');
    var emptyState = document.getElementById('emptyState');
    var tabSelect = document.getElementById('tabSelect');
    var refreshTabsBtn = document.getElementById('refreshTabsBtn');
    var tabStatus = document.getElementById('tabStatus');

    var busy = false;        // a scan or reconcile is running
    var loadingTabs = false; // the tab list is being fetched

    var fillBox = document.getElementById('fillBox');
    var missingNote = document.getElementById('missingNote');
    var fillCheckNo = document.getElementById('fillCheckNo');
    var fillPaidDate = document.getElementById('fillPaidDate');
    var fillBtn = document.getElementById('fillBtn');
    var fillStatus = document.getElementById('fillStatus');

    // set when Reconcile was clicked once despite rows missing a Check No. or Paid Date;
    // the next click posts them anyway. Any change to the table clears it.
    var postWithoutConfirmed = false;

    fileInput.addEventListener('change', function () {
      var file = fileInput.files[0];
      hideStatus(scanStatus);
      imagePreview.className = 'preview-img';
      imagePreview.src = '';
      filePreview.className = 'file-preview';
      filePreview.textContent = '';

      if (!file) {
        return;
      }

      var isPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name);

      if (isPdf) {
        filePreview.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0"><path d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M15 2v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span></span>';
        filePreview.querySelector('span').textContent = file.name;
        filePreview.className = 'file-preview visible';
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        imagePreview.src = e.target.result;
        imagePreview.className = 'preview-img visible';
        imagePreview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });

    scanBtn.addEventListener('click', function () {
      var file = fileInput.files[0];
      if (!file) {
        showStatus(scanStatus, 'Please choose a screenshot or PDF first.', 'error');
        return;
      }

      var reader = new FileReader();
      reader.onload = function (e) {
        setBusy(true, 'scan');
        showStatus(scanStatus, 'Scanning EOB with Gemini...', 'info');

        google.script.run
          .withSuccessHandler(onScanSuccess)
          .withFailureHandler(onScanFailure)
          .processEOBImage(e.target.result);
      };
      reader.onerror = function () {
        showStatus(scanStatus, 'Could not read the selected file.', 'error');
      };
      reader.readAsDataURL(file);
    });

    function onScanSuccess(result) {
      setBusy(false, 'scan');

      if (result && result.success) {
        renderRows(result.data || []);
        var count = (result.data || []).length;
        if (count > 0) {
          showStatus(scanStatus, 'Extracted ' + count + ' payment line' + (count === 1 ? '' : 's') + '. Review below before reconciling.', 'success');
        } else {
          showStatus(scanStatus, 'No payment lines were found in that file.', 'error');
        }
      } else {
        var message = (result && result.error) ? result.error : 'Unknown error while scanning.';
        showStatus(scanStatus, 'Scan failed: ' + message, 'error');
      }
    }

    function onScanFailure(error) {
      setBusy(false, 'scan');
      showStatus(scanStatus, 'Scan failed: ' + (error && error.message ? error.message : error), 'error');
    }

    reconcileBtn.addEventListener('click', function () {
      var tabName = tabSelect.value;
      if (!tabName) {
        showStatus(reconcileStatus, 'Pick the tab to post these payments to first.', 'error');
        return;
      }

      var rows = collectRows().filter(function (row) {
        return row.patientName;
      });

      if (rows.length === 0) {
        showStatus(reconcileStatus, 'No rows with a patient name to reconcile.', 'error');
        return;
      }

      // a row posted without these is hard to fix later (the sheet then sees it as already
      // paid), so ask for a second click before posting it
      var missing = countMissing();
      if (missing > 0 && !postWithoutConfirmed) {
        postWithoutConfirmed = true;
        showStatus(reconcileStatus, missing + ' row' + (missing === 1 ? ' has' : 's have') + ' no Check No. or Paid Date. Fill them in above, or click Reconcile again to post without them.', 'error');
        return;
      }

      setBusy(true, 'reconcile');
      showStatus(reconcileStatus, 'Reconciling ' + rows.length + ' payment' + (rows.length === 1 ? '' : 's') + ' to "' + tabName + '"...', 'info');

      google.script.run
        .withSuccessHandler(onReconcileSuccess)
        .withFailureHandler(onReconcileFailure)
        .reconcilePayments(rows, tabName);
    });

    function onReconcileSuccess(result) {
      setBusy(false, 'reconcile');

      if (result && result.success) {
        var onTab = result.sheetName ? ' on "' + result.sheetName + '"' : '';
        var msg = result.updatedCount > 0
          ? 'Filled in ' + result.updatedCount + ' existing row' + (result.updatedCount === 1 ? '' : 's') + onTab + '.'
          : 'Nothing to fill in' + onTab + ' — no genuinely blank matching rows were found.';
        var type = 'success';

        if (result.duplicateCount > 0) {
          msg += ' ' + result.duplicateCount + ' already recorded and skipped.';
          type = 'info';
        }
        if (result.conflictCount > 0) {
          msg += ' ' + result.conflictCount + ' already had different data recorded, left unchanged: ' + result.conflicts.join('; ') + '.';
          type = 'info';
        }
        if (result.unresolvedCount > 0) {
          msg += ' ' + result.unresolvedCount + ' had no matching row: ' + result.unresolved.join('; ') + '.';
          type = 'info';
        }

        showStatus(reconcileStatus, msg, type);
      } else {
        var message = (result && result.error) ? result.error : 'Unknown error while reconciling.';
        showStatus(reconcileStatus, 'Reconcile failed: ' + message, 'error');
      }
    }

    function onReconcileFailure(error) {
      setBusy(false, 'reconcile');
      showStatus(reconcileStatus, 'Reconcile failed: ' + (error && error.message ? error.message : error), 'error');
    }

    function renderRows(rows) {
      resultsBody.innerHTML = '';

      rows.forEach(function (row) {
        var tr = document.createElement('tr');

        FIELDS.forEach(function (field) {
          var td = document.createElement('td');
          td.contentEditable = 'true';
          td.dataset.field = field;
          td.textContent = row[field] || '';
          tr.appendChild(td);
        });

        var removeTd = document.createElement('td');
        removeTd.className = 'remove-cell';
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'remove-row';
        removeBtn.textContent = '×';
        removeBtn.title = 'Remove this row';
        removeBtn.addEventListener('click', function () {
          tr.remove();
          refreshEmptyState();
        });
        removeTd.appendChild(removeBtn);
        tr.appendChild(removeTd);

        resultsBody.appendChild(tr);
      });

      refreshEmptyState();
    }

    function collectRows() {
      var rows = [];
      Array.prototype.forEach.call(resultsBody.querySelectorAll('tr'), function (tr) {
        var row = {};
        Array.prototype.forEach.call(tr.querySelectorAll('td[data-field]'), function (td) {
          row[td.dataset.field] = td.textContent.trim();
        });
        rows.push(row);
      });
      return rows;
    }

    function refreshEmptyState() {
      var hasRows = resultsBody.children.length > 0;
      emptyState.style.display = hasRows ? 'none' : 'block';
      onTableChanged();
      updateControls();
    }

    // one place that decides which controls can be used right now
    function updateControls() {
      scanBtn.disabled = busy;
      fillBtn.disabled = busy;
      tabSelect.disabled = busy || loadingTabs || !tabSelect.value;
      refreshTabsBtn.disabled = busy || loadingTabs;
      reconcileBtn.disabled = busy || loadingTabs || !tabSelect.value || resultsBody.children.length === 0;
    }

    function setBusy(isBusy, which) {
      busy = isBusy;
      updateControls();

      if (which === 'scan') {
        scanBtn.innerHTML = isBusy ? '<span class="spinner"></span>Scanning...' : 'Scan EOB';
      } else if (which === 'reconcile') {
        reconcileBtn.innerHTML = isBusy ? '<span class="spinner"></span>Reconciling...' : 'Reconcile to Sheet';
      }
    }

    function showStatus(el, message, type) {
      el.textContent = message;
      el.className = 'status visible status-' + type;
    }

    function hideStatus(el) {
      el.className = 'status';
      el.textContent = '';
    }

    // ---- Check No. / Paid Date fill box ----

    // rows whose Check No. or Paid Date cell is still empty
    function countMissing() {
      var missing = 0;
      Array.prototype.forEach.call(resultsBody.querySelectorAll('tr'), function (tr) {
        var checkNo = tr.querySelector('td[data-field="checkNo"]');
        var paidDate = tr.querySelector('td[data-field="paidDate"]');
        if (!checkNo.textContent.trim() || !paidDate.textContent.trim()) {
          missing++;
        }
      });
      return missing;
    }

    // runs whenever the table changes: rows scanned, a cell edited, filled, or a row removed
    function onTableChanged() {
      postWithoutConfirmed = false;
      var missing = countMissing();
      fillBox.className = missing > 0 ? 'fill-box visible' : 'fill-box';
      missingNote.textContent = missing + ' row' + (missing === 1 ? ' has' : 's have') + ' no Check No. or Paid Date.';
    }

    resultsBody.addEventListener('input', onTableChanged);

    fillBtn.addEventListener('click', function () {
      var values = { checkNo: fillCheckNo.value.trim(), paidDate: fillPaidDate.value.trim() };
      if (!values.checkNo && !values.paidDate) {
        showStatus(fillStatus, 'Type the check number and paid date first.', 'error');
        return;
      }
      hideStatus(fillStatus);

      Array.prototype.forEach.call(resultsBody.querySelectorAll('td[data-field="checkNo"], td[data-field="paidDate"]'), function (td) {
        var value = values[td.dataset.field];
        if (value && !td.textContent.trim()) {
          td.textContent = value;
        }
      });
      onTableChanged();
    });

    // ---- tab picker ----

    refreshTabsBtn.addEventListener('click', loadTabs);

    // Asks the script for the attendance tabs and fills the dropdown. Keeps the tab that was
    // already picked if it's still there, otherwise starts on the tab that's open in the sheet.
    function loadTabs() {
      var keep = tabSelect.value;
      loadingTabs = true;
      setTabOptions([{ value: '', label: 'Loading tabs…' }], '');
      hideStatus(tabStatus);
      updateControls();

      google.script.run
        .withSuccessHandler(function (result) {
          onTabsLoaded(result, keep);
        })
        .withFailureHandler(function (error) {
          onTabsLoaded({ success: false, error: error && error.message ? error.message : String(error) }, keep);
        })
        .getLedgerTabs();
    }

    function onTabsLoaded(result, keep) {
      loadingTabs = false;
      var tabs = (result && result.success && result.tabs) || [];

      if (!result || !result.success) {
        setTabOptions([{ value: '', label: 'Could not load tabs' }], '');
        showStatus(tabStatus, 'Could not load the tab list: ' + ((result && result.error) || 'unknown error') + '. Click ↻ to try again.', 'error');
      } else if (!tabs.length) {
        setTabOptions([{ value: '', label: 'No attendance tabs found' }], '');
        showStatus(tabStatus, 'No tab has Paid Date, Reason, Check No. and Amount headings in its first rows, so there is nowhere to post payments yet.', 'error');
      } else {
        var names = tabs.map(function (t) {
          return t.name;
        });
        var pick = names.indexOf(keep) !== -1 ? keep
          : names.indexOf(result.active) !== -1 ? result.active
          : names[0];
        setTabOptions(tabs.map(function (t) {
          return { value: t.name, label: t.name + (t.hidden ? ' (hidden)' : '') };
        }), pick);
      }

      updateControls();
    }

    function setTabOptions(options, selected) {
      tabSelect.innerHTML = '';
      options.forEach(function (o) {
        var opt = document.createElement('option');
        opt.value = o.value;
        opt.textContent = o.label;
        tabSelect.appendChild(opt);
      });
      tabSelect.value = selected;
    }

    refreshEmptyState();
    loadTabs();
  </script>
</body>
</html>
